<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>GmodAddonOptimizer</AssemblyName>
    <RootNamespace>GmodAddonCompressor</RootNamespace>
    <AssemblyTitle>GMod Addon Optimizer</AssemblyTitle>
    <Product>GMod Addon Optimizer</Product>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin\**\*.cs;obj\**\*.cs" />
    <Content Include="icon.ico" />
    <EmbeddedResource Include="Resources\VtfMaximumTools.zip"
                      LogicalName="GmodAddonCompressor.Resources.VtfMaximumTools.zip" />
    <EmbeddedResource Include="Resources\universal-vtf-v1-fixtures.json"
                      LogicalName="GmodAddonCompressor.Resources.universal-vtf-v1-fixtures.json" />
    <EmbeddedResource Include="Resources\SourceAddonOptimizerCompanion.zip"
                      LogicalName="GmodAddonCompressor.Resources.SourceAddonOptimizerCompanion.zip" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\experiments\VtfMaximumLab\Candidates\*.cs" Link="Systems\Vtf\Maximum\Candidates\%(Filename)%(Extension)" />
    <Compile Include="..\..\experiments\VtfMaximumLab\Encoding\*.cs" Link="Systems\Vtf\Maximum\Encoding\%(Filename)%(Extension)" />
    <Compile Include="..\..\experiments\VtfMaximumLab\Inventory\*.cs" Link="Systems\Vtf\Maximum\Inventory\%(Filename)%(Extension)" />
    <Compile Include="..\..\experiments\VtfMaximumLab\Validation\*.cs" Link="Systems\Vtf\Maximum\Validation\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.10.4" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="6.0.0" />
    <PackageReference Include="NAudio" Version="2.1.0" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="NLua" Version="1.6.0" />
    <PackageReference Include="Ookii.Dialogs.Wpf" Version="5.0.1" />
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
