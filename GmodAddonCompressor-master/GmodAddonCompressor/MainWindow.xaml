                    </Border>
                </StackPanel>
            </ScrollViewer><Border Grid.Row="1" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16"><DockPanel><Button Content="Exportar candidato exato" Click="Button_ExactExport_Click" HorizontalAlignment="Right" DockPanel.Dock="Right" IsEnabled="{Binding UnlockedUI}" Style="{StaticResource ButtonAccent}" /><WrapPanel Margin="0">
                                <Button x:Name="Button_ExactCancel" Content="Cancelar" Click="Button_ExactCancel_Click" IsEnabled="False" Margin="0,0,8,0" />
                                <Button x:Name="Button_ExactOpenOutput" Content="Abrir saída" Click="Button_ExactOpenOutput_Click" IsEnabled="False" Margin="0,0,8,0" />
                                <Button x:Name="Button_ExactOpenReport" Content="Abrir relatório" Click="Button_ExactOpenReport_Click" IsEnabled="False" Margin="0,0,8,0" />
                                <Button Content="Abrir work" Click="Button_ExactOpenWork_Click" />
                            </WrapPanel></DockPanel></Border></Grid></TabItem>
        <TabItem Header="Pipeline"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <Grid Background="{DynamicResource AppBackground}" Margin="8">
