                                             Text="{Binding LastProfilePath, Mode=OneWay}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             MinHeight="48" />
                                    <TextBlock Style="{StaticResource MutedText}"
                                               Margin="0,10,0,0"
                                               Text="{Binding ProfileSummaryText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource MutedText}"
                                               Margin="0,8,0,0"
                                               Text="{Binding ProfileOriginText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource MutedText}"
                                               Margin="0,3,0,0"
                                               Text="{Binding ProfileAgeText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource MutedText}"
                                               Margin="0,3,0,0"
                                               Text="{Binding ProfileMatchText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource MutedText}"
                                               Margin="0,3,0,0"
                                               Text="{Binding ProfileTruncationText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource MutedText}"
                                               Margin="0,3,0,0"
                                               Text="{Binding ProfileCompatibilityText}"
                                               TextWrapping="Wrap" />
