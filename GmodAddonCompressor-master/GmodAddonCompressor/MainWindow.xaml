                                    </Grid>
                                    <TextBlock Style="{StaticResource MutedText}"
                                               Margin="0,8,0,0"
                                               Text="{Binding InstallationDetailText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource MutedText}"
                                               Margin="0,6,0,0"
                                               Text="{Binding InstallDestinationText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ActionBarCard}" Margin="0,12,0,0">
                                <WrapPanel>
                                    <Button x:Name="Button_CompanionInstall"
                                            Style="{StaticResource ButtonAccent}"
                                            Content="Install Companion"
                                            MinWidth="142"
                                            IsEnabled="{Binding CanInstall}" />
                                    <Button x:Name="Button_CompanionUpdate"
                                            Margin="8,0,0,0"
                                            Content="Update"
                                            MinWidth="88"
                                            IsEnabled="{Binding CanUpdate}" />
                                    <Button x:Name="Button_CompanionRemove"
                                            Style="{StaticResource ButtonDanger}"
                                            Margin="8,0,0,0"
                                            Content="Remove"
                                            MinWidth="88"
                                            IsEnabled="{Binding CanRemove}" />
                                    <Button x:Name="Button_CompanionOpenData"
                                            Margin="8,0,0,0"
                                            Content="Open Data Folder"
                                            MinWidth="126"
                                            IsEnabled="{Binding CanOpenDataFolder}" />
                                </WrapPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardEyebrowText}" Text="RUNTIME EVIDENCE" />
                            <TextBlock Style="{StaticResource CardHeaderTitle}" Text="Profile import" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Bring back a bounded profile recorded while you drive, inspect and use the addon in Garry's Mod. Importing never enables it automatically." />
                            <Border Style="{StaticResource CardInnerPanel}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource LabelText}" Text="Last selected profile" />
