<Window x:Class="GmodAddonCompressor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GmodAddonCompressor"
        mc:Ignorable="d"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackground}"
        Title="GMod Addon Optimizer"
        MinHeight="640"
        MinWidth="1024"
        Height="800"
        Width="1280">

    <Grid Background="{DynamicResource AppBackground}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>

        <!-- Navigation rail (Material 3): Otimizar, Avançado, Ferramentas, Testar no jogo -->
        <DockPanel Grid.RowSpan="2" Background="{DynamicResource AppBackground}">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,14">
                <TextBlock x:Name="VersionId" Style="{StaticResource MutedText}" Text="VERSION" FontSize="11" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource MutedText}" Text="Hanic" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel>
                <Border Width="48" Height="48" CornerRadius="16" Background="{DynamicResource PrimaryContainer}" Margin="0,16,0,28"
                        HorizontalAlignment="Center" ToolTip="GMod Addon Optimizer">
                    <TextBlock Text="g" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource OnPrimaryContainer}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" />
                </Border>
                <RadioButton x:Name="Rail_Optimize" Style="{StaticResource RailButton}" Content="Otimizar" Tag="&#xE945;" />
                <RadioButton x:Name="Rail_Advanced" Style="{StaticResource RailButton}" Content="Avançado" Tag="&#xE9E9;" />
                <RadioButton x:Name="Rail_Tools" Style="{StaticResource RailButton}" Content="Ferramentas" Tag="&#xE90F;" />
                <RadioButton x:Name="Rail_Test" Style="{StaticResource RailButton}" Content="Testar no jogo" Tag="&#xE7FC;" />
            </StackPanel>
        </DockPanel>

        <!-- Secondary tabs of Avançado and Ferramentas -->
        <Border x:Name="SecondaryNavBar" Grid.Column="1" Background="{DynamicResource AppBackground}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Visibility="Collapsed">
            <Grid Margin="16,0">
                <StackPanel x:Name="AdvancedTabsPanel" Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SecondaryTab}" GroupName="AdvancedTabs" Content="Modelos" Tag="Tab_Models" IsChecked="True" />
                    <RadioButton Style="{StaticResource SecondaryTab}" GroupName="AdvancedTabs" Content="Texturas e sons" Tag="Tab_Media" />
                </StackPanel>
                <StackPanel x:Name="ToolsTabsPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <RadioButton Style="{StaticResource SecondaryTab}" GroupName="ToolsTabs" Content="Descompactar" Tag="Tab_Unpack" IsChecked="True" />
                    <RadioButton Style="{StaticResource SecondaryTab}" GroupName="ToolsTabs" Content="Juntar addons" Tag="Tab_Merge" />
                    <RadioButton Style="{StaticResource SecondaryTab}" GroupName="ToolsTabs" Content="Mapas" Tag="Tab_Maps" />
                    <RadioButton Style="{StaticResource SecondaryTab}" GroupName="ToolsTabs" Content="Distribuição exata" Tag="Tab_Exact" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Grid.Column="1" Style="{StaticResource ShellTabControl}">

        <TabItem Header="Otimizar" x:Name="Tab_Wizard" IsSelected="True">
            <Grid x:Name="WizardRoot" Background="{DynamicResource AppBackground}" TextElement.Foreground="{DynamicResource TextPrimary}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title and step indicator -->
                <StackPanel Margin="32,22,32,6" MaxWidth="880">
                    <TextBlock Text="Otimizar addon" FontSize="22" />
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="24" Height="24">
                                <Ellipse Stroke="{DynamicResource BorderStrong}" StrokeThickness="1.5" />
                                <Ellipse Fill="{DynamicResource Accent}" Visibility="{Binding Step1Current, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Ellipse Fill="{DynamicResource SecondaryContainer}" Visibility="{Binding Step1Done, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource OnSecondaryContainer}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding Step1Done, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Text="1" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /><Style.Triggers>
                                        <DataTrigger Binding="{Binding Step1Current}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentForeground}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Step1Done}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TextBlock Text="Addon" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Rectangle Grid.Column="1" Height="1" Fill="{DynamicResource Border}" Margin="14,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Grid Width="24" Height="24">
                                <Ellipse Stroke="{DynamicResource BorderStrong}" StrokeThickness="1.5" />
                                <Ellipse Fill="{DynamicResource Accent}" Visibility="{Binding Step2Current, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Ellipse Fill="{DynamicResource SecondaryContainer}" Visibility="{Binding Step2Done, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource OnSecondaryContainer}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding Step2Done, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Text="2" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /><Style.Triggers>
                                        <DataTrigger Binding="{Binding Step2Current}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentForeground}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Step2Done}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TextBlock Text="Objetivo" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Rectangle Grid.Column="3" Height="1" Fill="{DynamicResource Border}" Margin="14,0" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <Grid Width="24" Height="24">
                                <Ellipse Stroke="{DynamicResource BorderStrong}" StrokeThickness="1.5" />
                                <Ellipse Fill="{DynamicResource Accent}" Visibility="{Binding Step3Current, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Ellipse Fill="{DynamicResource SecondaryContainer}" Visibility="{Binding Step3Done, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource OnSecondaryContainer}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding Step3Done, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Text="3" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /><Style.Triggers>
                                        <DataTrigger Binding="{Binding Step3Current}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentForeground}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Step3Done}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TextBlock Text="Otimizar" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <ScrollViewer x:Name="WizardScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid MaxWidth="880" Margin="32,10,32,24">

                        <!-- Step 1: addon -->
                        <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Qual addon você quer otimizar?" FontSize="24" Margin="0,8,0,16" />

                            <Grid x:Name="WizardDropZone" AllowDrop="True" Background="Transparent" Margin="0,0,0,20"
                                  Drop="WizardDropZone_Drop" DragOver="WizardDropZone_DragOver"
                                  Visibility="{Binding ShowDropZone, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Rectangle x:Name="WizardDropFrame" RadiusX="16" RadiusY="16" Fill="{DynamicResource Surface1}"
                                           Stroke="{DynamicResource BorderStrong}" StrokeThickness="1.5" StrokeDashArray="4 3" />
                                <StackPanel Margin="24,34" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="32" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Arraste a pasta do addon aqui" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                                    <TextBlock Text="ou" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,10" />
                                    <Button Style="{StaticResource FilledButton}" Click="WizardBrowse_Click" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="Escolher pasta…" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <StackPanel Visibility="{Binding ShowRecent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Recentes" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Recent}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="WizardRecent_Click" Tag="{Binding Path}" Cursor="Hand" Margin="0,0,0,6" HorizontalContentAlignment="Stretch">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Padding="12,10" BorderThickness="1" BorderBrush="{DynamicResource Border}">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface1}" /></Trigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="4,0,14,0" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasAddon, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Style="{StaticResource M3Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource PrimaryContainer}" Margin="0,0,14,0">
                                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource OnPrimaryContainer}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AddonName}" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding AddonPath}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AddonPath}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource TextButton}" Content="Trocar" Click="WizardBrowse_Click" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0" Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ProgressBar IsIndeterminate="True" Width="120" Height="4" VerticalAlignment="Center" />
                                            <TextBlock Text="Lendo os arquivos…" Foreground="{DynamicResource TextSecondary}" Margin="12,0,0,0" />
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding HasInventory, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Margin="0,16,0,12">
                                                <Run Text="{Binding TotalSizeText, Mode=OneWay}" FontSize="28" />
                                                <Run Text="   " />
                                                <Run Text="{Binding TotalFilesText, Mode=OneWay}" FontSize="14" Foreground="{DynamicResource TextSecondary}" />
                                            </TextBlock>
                                            <UniformGrid Columns="2">
                                                <Border Background="{DynamicResource Surface2}" CornerRadius="12" Padding="14,10" Margin="0,0,6,6">
                                                    <DockPanel>
                                                        <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ModelsSizeText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <StackPanel><TextBlock Text="Modelos" /><TextBlock Text="{Binding ModelsFilesText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></StackPanel>
                                                    </DockPanel>
                                                </Border>
                                                <Border Background="{DynamicResource Surface2}" CornerRadius="12" Padding="14,10" Margin="6,0,0,6">
                                                    <DockPanel>
                                                        <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TexturesSizeText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <StackPanel><TextBlock Text="Texturas" /><TextBlock Text="{Binding TexturesFilesText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></StackPanel>
                                                    </DockPanel>
                                                </Border>
                                                <Border Background="{DynamicResource Surface2}" CornerRadius="12" Padding="14,10" Margin="0,6,6,0">
                                                    <DockPanel>
                                                        <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SoundsSizeText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <StackPanel><TextBlock Text="Sons" /><TextBlock Text="{Binding SoundsFilesText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></StackPanel>
                                                    </DockPanel>
                                                </Border>
                                                <Border Background="{DynamicResource Surface2}" CornerRadius="12" Padding="14,10" Margin="6,6,0,0">
                                                    <DockPanel>
                                                        <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding OthersSizeText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <StackPanel><TextBlock Text="Outros" /><TextBlock Text="{Binding OthersFilesText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </UniformGrid>
                                        </StackPanel>
                                        <TextBlock Text="Esta pasta não parece um addon (faltam pastas como models, materials ou sound)."
                                                   Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Margin="0,12,0,0"
                                                   Visibility="{Binding ShowNotAddonWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Salvar em" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="2,20,0,6" />
                                <TextBox Text="{Binding OutputPath, Mode=OneWay}" IsReadOnly="True" Height="44" VerticalContentAlignment="Center" Padding="12,0"
                                         AutomationProperties.Name="Pasta onde o addon otimizado será salvo" />
                                <TextBlock Text="Os originais não são alterados." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="2,6,0,0" />
                                <TextBlock Text="Essa pasta já existe e será substituída." FontSize="12" Foreground="{DynamicResource Warning}" Margin="2,4,0,0"
                                           Visibility="{Binding OutputExists, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Step 2: goal and profile -->
                        <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="O que você quer otimizar?" FontSize="24" Margin="0,8,0,16" />
                            <RadioButton Style="{StaticResource ChoiceCard}" GroupName="WizardGoal" IsChecked="{Binding GoalFull, Mode=TwoWay}" IsEnabled="{Binding CanGoalFull}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Addon completo" FontSize="16" FontWeight="SemiBold" />
                                        <Border Style="{StaticResource M3Chip}" Margin="10,0,0,0"><TextBlock Text="Recomendado" FontSize="12" Foreground="{DynamicResource OnSecondaryContainer}" /></Border>
                                    </StackPanel>
                                    <TextBlock Text="Modelos, texturas e sons de uma vez." Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource ChoiceCard}" GroupName="WizardGoal" IsChecked="{Binding GoalModels, Mode=TwoWay}" IsEnabled="{Binding CanGoalModels}">
                                <StackPanel>
                                    <TextBlock Text="Só modelos" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding GoalModelsHint}" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource ChoiceCard}" GroupName="WizardGoal" IsChecked="{Binding GoalMedia, Mode=TwoWay}" IsEnabled="{Binding CanGoalMedia}">
                                <StackPanel>
                                    <TextBlock Text="Só texturas e sons" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding GoalMediaHint}" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="Perfil" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,10" />
                            <UniformGrid Columns="3">
                                <RadioButton Style="{StaticResource ChoiceCard}" GroupName="WizardProfile" IsChecked="{Binding ProfileLossless, Mode=TwoWay}" Margin="0,0,6,8" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                                    <StackPanel>
                                        <TextBlock Text="Sem perda" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Aparência e som idênticos. Só mexe no que não muda nada no jogo." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource ChoiceCard}" GroupName="WizardProfile" IsChecked="{Binding ProfileBalanced, Mode=TwoWay}" Margin="3,0,3,8">
                                    <StackPanel>
                                        <WrapPanel>
                                            <TextBlock Text="Custo-benefício" FontSize="16" FontWeight="SemiBold" Margin="0,0,8,4" />
                                            <Border Style="{StaticResource M3Chip}" Margin="0,0,0,4"><TextBlock Text="Recomendado" FontSize="12" Foreground="{DynamicResource OnSecondaryContainer}" /></Border>
                                        </WrapPanel>
                                        <TextBlock Text="Bem menor, com perda quase invisível. Levou o pacote LVS de 1375 para 132 MiB." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource ChoiceCard}" GroupName="WizardProfile" IsChecked="{Binding ProfileMax, Mode=TwoWay}" Margin="6,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Máximo" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="O menor possível. Aceita perda visível de perto, como texturas 4x menores." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <RadioButton Style="{StaticResource ChoiceCard}" GroupName="WizardProfile" IsChecked="{Binding ProfileCustom, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Personalizado" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Você escolhe o que fazer com modelos, texturas e sons." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </RadioButton>

                            <Border Style="{StaticResource M3Card}" Margin="0,6,0,0" Padding="20,16,20,10"
                                    Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <StackPanel Visibility="{Binding ShowCustomModels, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,14">
                                        <TextBlock Text="Modelos" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                                        <WrapPanel>
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CustomModels" Content="Não mexer"
                                                     IsChecked="{Binding CustomModels, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=none, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CustomModels" Content="Sem perda"
                                                     IsChecked="{Binding CustomModels, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=exact, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CustomModels" Content="Equilibrado"
                                                     IsChecked="{Binding CustomModels, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=balanced, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CustomModels" Content="Forte"
                                                     IsChecked="{Binding CustomModels, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=strong, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CustomModels" Content="Forte + espelho"
                                                     IsChecked="{Binding CustomModels, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=strong_mirror, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CustomModels" Content="Stream"
                                                     IsChecked="{Binding CustomModels, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=stream, Mode=TwoWay}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding CustomModelsHint}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding ShowCustomMedia, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="Texturas" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                                        <WrapPanel>
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CustomTextures" Content="Não mexer"
                                                     IsChecked="{Binding CustomTextures, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=none, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CustomTextures" Content="Sem perda"
                                                     IsChecked="{Binding CustomTextures, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=exact, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CustomTextures" Content="Equilibrado"
                                                     IsChecked="{Binding CustomTextures, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=q50, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CustomTextures" Content="Forte"
                                                     IsChecked="{Binding CustomTextures, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=strong, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CustomTextures" Content="Máximo"
                                                     IsChecked="{Binding CustomTextures, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=max, Mode=TwoWay}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding CustomTexturesHint}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,14" />

                                        <TextBlock Text="Sons" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                                        <WrapPanel>
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CustomSounds" Content="Não mexer"
                                                     IsChecked="{Binding CustomSounds, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=none, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CustomSounds" Content="Adaptativo"
                                                     IsChecked="{Binding CustomSounds, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=adaptive, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CustomSounds" Content="Manual"
                                                     IsChecked="{Binding CustomSounds, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=manual, Mode=TwoWay}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding CustomSoundsHint}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                        <UniformGrid Columns="3" Margin="0,12,0,0" Visibility="{Binding ShowCustomManualWav, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="Taxa" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,4" />
                                                <ComboBox ItemsSource="{Binding WavRates}" SelectedIndex="{Binding CustomWavRateIndex, Mode=TwoWay}" AutomationProperties.Name="Taxa dos sons" />
                                            </StackPanel>
                                            <StackPanel Margin="4,0,4,0">
                                                <TextBlock Text="Canais" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,4" />
                                                <ComboBox ItemsSource="{Binding WavChannels}" SelectedIndex="{Binding CustomWavChannelsIndex, Mode=TwoWay}" AutomationProperties.Name="Canais dos sons" />
                                            </StackPanel>
                                            <StackPanel Margin="8,0,0,0">
                                                <TextBlock Text="Formato" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,4" />
                                                <ComboBox ItemsSource="{Binding WavCodecs}" SelectedIndex="{Binding CustomWavCodecIndex, Mode=TwoWay}" AutomationProperties.Name="Formato dos sons" />
                                            </StackPanel>
                                        </UniformGrid>

                                        <CheckBox IsChecked="{Binding CustomLua, Mode=TwoWay}" Margin="0,16,0,6">
                                            <StackPanel>
                                                <TextBlock Text="Minificar scripts Lua" />
                                                <TextBlock Text="Remove espaços e comentários. Teste o addon depois." FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Escolha ao menos uma coisa para otimizar." Foreground="{DynamicResource Warning}" Margin="2,10,0,0"
                                       Visibility="{Binding ShowNothingHint, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <Border Style="{StaticResource M3Card}" Background="{DynamicResource Surface1}" Margin="0,6,0,0"
                                    Visibility="{Binding ShowPresetSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Grid.ColumnSpan="2" Text="O que este perfil faz" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="1" Text="Modelos" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" Visibility="{Binding ShowModelsLine, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProfileModelsLine}" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="{Binding ShowModelsLine, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Grid.Row="2" Text="Texturas" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" Visibility="{Binding ShowMediaLines, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProfileTexturesLine}" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="{Binding ShowMediaLines, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Grid.Row="3" Text="Sons" Foreground="{DynamicResource TextSecondary}" Visibility="{Binding ShowMediaLines, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProfileSoundsLine}" TextWrapping="Wrap" Visibility="{Binding ShowMediaLines, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>
                            <Button Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="-4,12,0,0" Click="WizardAdvanced_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9E9;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Prefere ajustar cada opção? Abrir o modo Avançado" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Step 3: review, running, done, failed -->
                        <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Visibility="{Binding IsReview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Tudo pronto" FontSize="24" Margin="0,8,0,4" />
                                <TextBlock Text="Confira e clique em Otimizar." Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16" />
                                <Border Style="{StaticResource M3Card}" Padding="16,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Text="Addon" Foreground="{DynamicResource TextSecondary}" Margin="0,12" />
                                        <TextBlock Grid.Column="1" Text="{Binding AddonPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AddonPath}" Margin="0,12" />
                                        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" />
                                        <TextBlock Grid.Row="1" Text="Salvar em" Foreground="{DynamicResource TextSecondary}" Margin="0,12" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OutputPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputPath}" Margin="0,12" />
                                        <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" />
                                        <TextBlock Grid.Row="2" Text="O que otimizar" Foreground="{DynamicResource TextSecondary}" Margin="0,12" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GoalTitle}" Margin="0,12" />
                                        <Border Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" />
                                        <TextBlock Grid.Row="3" Text="Perfil" Foreground="{DynamicResource TextSecondary}" Margin="0,12" />
                                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,12">
                                            <TextBlock Text="{Binding ProfileTitle}" />
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding ShowModelsLine, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Run Text="Modelos: " /><Run Text="{Binding ProfileModelsLine, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Visibility="{Binding ShowMediaLines, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Run Text="Texturas: " /><Run Text="{Binding ProfileTexturesLine, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Visibility="{Binding ShowMediaLines, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Run Text="Sons: " /><Run Text="{Binding ProfileSoundsLine, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="A pasta de saída já existe e será substituída." Foreground="{DynamicResource Warning}" Margin="2,10,0,0"
                                           Visibility="{Binding OutputExists, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DockPanel Margin="0,8,0,4">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontSize="22" VerticalAlignment="Bottom" />
                                    <TextBlock Text="Otimizando…" FontSize="24" />
                                </DockPanel>
                                <TextBlock Text="{Binding StageText}" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,14,0,8" />
                                <TextBlock Text="{Binding ElapsedText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16" />
                                <Border Style="{StaticResource M3Card}" Padding="16,4">
                                    <ItemsControl ItemsSource="{Binding Stages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,12">
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="18" VerticalAlignment="Center" Margin="0,0,14,0">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Accent}" /><Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPending}" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /></DataTrigger>
                                                        </Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="16" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <TextBlock Margin="2,12,0,0" Visibility="{Binding HasCurrentItem, Converter={StaticResource BooleanToVisibilityConverter}}" TextTrimming="CharacterEllipsis">
                                    <Run Text="Agora " Foreground="{DynamicResource TextSecondary}" />
                                    <Run Text="{Binding CurrentItem, Mode=OneWay}" FontFamily="Consolas" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsDone, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
                                    <Grid Width="40" Height="40">
                                        <Ellipse Fill="{DynamicResource Accent}" />
                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource AccentForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Pronto" FontSize="24" />
                                        <TextBlock Text="{Binding ResultSubtitle}" Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock FontSize="36">
                                    <Run Text="{Binding ResultBefore, Mode=OneWay}" />
                                    <Run Text=" → " Foreground="{DynamicResource TextSecondary}" />
                                    <Run Text="{Binding ResultAfter, Mode=OneWay}" />
                                </TextBlock>
                                <Border Background="{DynamicResource SecondaryContainer}" CornerRadius="16" Padding="16,6" HorizontalAlignment="Left" Margin="0,12,0,18">
                                    <TextBlock Text="{Binding ResultReduction}" FontWeight="SemiBold" Foreground="{DynamicResource OnSecondaryContainer}" />
                                </Border>
                                <Border Style="{StaticResource M3Card}" Padding="16,6">
                                    <ItemsControl ItemsSource="{Binding ResultRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="RowBorder" BorderBrush="{DynamicResource Border}" BorderThickness="0" Padding="0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="340" />
                                                            <ColumnDefinition />
                                                            <ColumnDefinition Width="64" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="RowName" Text="{Binding Name}" VerticalAlignment="Center" />
                                                        <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <Border Width="{Binding BeforeWidth}" Height="8" CornerRadius="4" Background="{DynamicResource SecondaryContainer}" HorizontalAlignment="Left" />
                                                            <Border Width="{Binding AfterWidth}" Height="8" CornerRadius="4" Background="{DynamicResource Accent}" HorizontalAlignment="Left" />
                                                        </Grid>
                                                        <TextBlock x:Name="RowSizes" Grid.Column="2" Text="{Binding SizesText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                                                        <TextBlock x:Name="RowReduction" Grid.Column="3" Text="{Binding ReductionText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsTotal}" Value="True">
                                                        <Setter TargetName="RowBorder" Property="BorderThickness" Value="0,1,0,0" />
                                                        <Setter TargetName="RowName" Property="FontWeight" Value="SemiBold" />
                                                        <Setter TargetName="RowSizes" Property="FontWeight" Value="SemiBold" />
                                                        <Setter TargetName="RowSizes" Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                                        <Setter TargetName="RowReduction" Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>

                            <Border Style="{StaticResource M3Card}" BorderBrush="{DynamicResource Danger}" Margin="0,8,0,0"
                                    Visibility="{Binding IsFailed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DockPanel>
                                    <TextBlock Text="&#xE783;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{DynamicResource Danger}" VerticalAlignment="Top" Margin="0,2,14,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding ErrorTitle}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <StackPanel Visibility="{Binding ShowRunPanels, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,10,0,0">
                                <Button Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="-4,0,0,0" Click="WizardToggleLog_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding LogToggleText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBox x:Name="TextBox_WizardLog" Style="{StaticResource LogTextBox}" Height="220" Margin="0,6,0,0"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                         Visibility="{Binding LogExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         AutomationProperties.Name="Detalhes da otimização" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Footer actions -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="32,14">
                    <Grid MaxWidth="880">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Style="{StaticResource TextButton}" Content="Voltar" Click="WizardBack_Click"
                                    Visibility="{Binding FooterBack, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Style="{StaticResource TextButton}" Content="Otimizar outro addon" Click="WizardRestart_Click"
                                    Visibility="{Binding FooterDone, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource FilledButton}" Click="WizardContinue_Click" IsEnabled="{Binding CanContinue}"
                                    Visibility="{Binding FooterContinue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Continuar" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="Button_WizardStart" Style="{StaticResource FilledButton}" Click="WizardStart_Click" IsEnabled="{Binding Available}" Padding="32,0"
                                    Visibility="{Binding FooterStart, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Otimizar" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource OutlinedButton}" Content="Cancelar" Click="WizardCancel_Click"
                                    Visibility="{Binding FooterCancel, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding FooterDone, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button Style="{StaticResource OutlinedButton}" Content="Ver relatório" Click="WizardReport_Click" Margin="0,0,8,0" />
                                <Button Style="{StaticResource TonalButton}" Click="WizardTestInGame_Click" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Testar no jogo" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource FilledButton}" Click="WizardOpenOutput_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Abrir pasta" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding FooterRetry, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button Style="{StaticResource OutlinedButton}" Content="Ver relatório" Click="WizardReport_Click" Margin="0,0,8,0" />
                                <Button Style="{StaticResource FilledButton}" Content="Tentar de novo" Click="WizardRetry_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="Compressão completa" x:Name="Tab_FullCompression">
            <Grid x:Name="FullWorkspace" Background="{DynamicResource AppBackground}" TextElement.Foreground="{DynamicResource TextPrimary}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="88" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="64" />
                </Grid.RowDefinitions>

                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Hint}" Style="{StaticResource C2Hint}" Margin="0,5,12,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border>
                            <Border.Style><Style TargetType="Border" BasedOn="{StaticResource C2Step}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanEdit}" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceAccent}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsResult}" Value="True"><Setter Property="Background" Value="{DynamicResource Surface2}" /></DataTrigger>
                                </Style.Triggers>
                            </Style></Border.Style>
                            <TextBlock Text="1  Preparar" FontSize="12" />
                        </Border>
                        <Border>
                            <Border.Style><Style TargetType="Border" BasedOn="{StaticResource C2Step}">
                                <Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceAccent}" /></DataTrigger></Style.Triggers>
                            </Style></Border.Style>
                            <TextBlock Text="2  Processar" FontSize="12" />
                        </Border>
                        <Border>
                            <Border.Style><Style TargetType="Border" BasedOn="{StaticResource C2Step}">
                                <Style.Triggers><DataTrigger Binding="{Binding IsResult}" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceAccent}" /></DataTrigger></Style.Triggers>
                            </Style></Border.Style>
                            <TextBlock Text="3  Testar no jogo" FontSize="12" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1">
                    <Grid Margin="24,8" IsEnabled="{Binding CanEdit}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="24" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Addon original · somente leitura" Style="{StaticResource C2Label}" />
                            <DockPanel Height="40">
                                <Button DockPanel.Dock="Right" Content="Escolher…" Tag="input" Click="Button_FullBrowse_Click" Margin="8,0,0,0" Padding="12,9" />
                                <TextBox x:Name="TextBox_FullInput" AutomationProperties.Name="Addon de entrada da compressão completa" FontSize="14" Height="40" Padding="10,3" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"  HorizontalScrollBarVisibility="Hidden" VerticalContentAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Onde salvar · uma pasta nova" Style="{StaticResource C2Label}" />
                            <DockPanel Height="40">
                                <Button DockPanel.Dock="Right" Content="Escolher…" Tag="output" Click="Button_FullBrowse_Click" Margin="8,0,0,0" Padding="12,9" />
                                <TextBox x:Name="TextBox_FullOutput" AutomationProperties.Name="Pasta final da compressão completa" FontSize="14" Height="40" Padding="10,3" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"  HorizontalScrollBarVisibility="Hidden" VerticalContentAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <DockPanel Margin="24,0">
                            <TextBlock Text="Arquivos do addon" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="INVENTÁRIO SOMENTE LEITURA" FontSize="10" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </DockPanel>
                        <DataGrid x:Name="DataGrid_FullFiles" Grid.Row="1" Style="{StaticResource C2FilesGrid}"
                                  ItemsSource="{Binding Files}" Visibility="{Binding ShowFiles, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  AutomationProperties.Name="Inventário dos arquivos do addon"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ARQUIVO" Binding="{Binding Path}" Width="*" MinWidth="160">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="ToolTip" Value="{Binding Path}" /></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="TIPO" Binding="{Binding Type}" Width="75" />
                                <DataGridTextColumn Header="BYTES" Binding="{Binding Bytes, StringFormat={}{0:N0}}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Margin="24">
                                <Canvas Width="64" Height="48" Margin="0,0,0,18">
                                    <Path Data="M 2,10 L 24,10 L 31,17 L 62,17 L 62,45 L 2,45 Z" Stroke="{DynamicResource Accent}" StrokeThickness="2" Fill="{DynamicResource SurfaceAccent}" />
                                    <Path Data="M 2,19 L 62,19" Stroke="{DynamicResource Accent}" StrokeThickness="2" />
                                </Canvas>
                                <TextBlock Text="Seu addon começa aqui" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="Escolha a pasta original acima. O processamento usa uma cópia e salva o resultado em um novo local."
                                           Style="{StaticResource C2Hint}" TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="TextBlock_FullInventoryHint" Grid.Row="2" Text="Selecione um addon para consultar seus arquivos."
                                   Style="{StaticResource HintText}" Margin="24,6,24,6" />
                    </Grid>
                    <Border Grid.Column="1" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="20,16,20,18">
                                <TextBlock Text="Resumo do processamento" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,13" />
                                <Border Background="{DynamicResource SurfaceAccent}" Padding="12" Margin="0,0,0,14"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Phase}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" />
                                        <ProgressBar x:Name="ProgressBar_Full" Margin="0,13,0,0" Minimum="0" Maximum="1" Height="6" />
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="{DynamicResource Warning}" BorderThickness="3,0,0,0" Padding="12,3" Margin="0,0,0,12"
                                        Visibility="{Binding IsResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="Validação no GMod pendente" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" />
                                        <TextBlock Text="OFFLINE_PENDING_GMOD" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Expander Header="Resumo e evidências" IsExpanded="{Binding IsResult, Mode=OneWay}" Margin="0,0,0,15" FontSize="14" Visibility="{Binding IsResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBox x:Name="TextBox_FullSummary" Style="{StaticResource ReportTextBox}" MinHeight="110" Height="160" Margin="0,12,0,0"  VerticalContentAlignment="Top"/>
                                </Expander>
                                <TextBlock Text="Completo · Safe" Style="{StaticResource C2Label}" />
                                <TextBlock Text="Cópia → modelos → mídia → exata" Style="{StaticResource C2Hint}" />

                                <Expander Header="Configurar jogo e ferramentas" Margin="0,14,0,0" FontSize="14">
                                    <StackPanel Margin="0,14,0,0" IsEnabled="{Binding CanEdit}">
                                        <TextBlock Text="Garry's Mod" Style="{StaticResource C2Label}" />
                                        <DockPanel Margin="0,0,0,13"><Button DockPanel.Dock="Right" Content="…" Tag="engine" Click="Button_FullBrowse_Click" Margin="7,0,0,0" AutomationProperties.Name="Escolher instalação do Garry's Mod" /><TextBox x:Name="TextBox_FullEngine" AutomationProperties.Name="Instalação do Garry's Mod"  Height="40" HorizontalScrollBarVisibility="Hidden" VerticalContentAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>
                                        <TextBlock Text="Blender" Style="{StaticResource C2Label}" />
                                        <DockPanel Margin="0,0,0,13"><Button DockPanel.Dock="Right" Content="…" Tag="blender" Click="Button_FullBrowse_Click" Margin="7,0,0,0" AutomationProperties.Name="Escolher Blender" /><TextBox x:Name="TextBox_FullBlender"  Height="40" HorizontalScrollBarVisibility="Hidden" VerticalContentAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>
                                        <TextBlock Text="studiomdl.exe" Style="{StaticResource C2Label}" />
                                        <DockPanel Margin="0,0,0,13"><Button DockPanel.Dock="Right" Content="…" Tag="studiomdl" Click="Button_FullBrowse_Click" Margin="7,0,0,0" AutomationProperties.Name="Escolher compilador Source" /><TextBox x:Name="TextBox_FullStudioMdl"  Height="40" HorizontalScrollBarVisibility="Hidden" VerticalContentAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>
                                        <Button Content="Detectar ferramentas instaladas" Click="Button_FullDetect_Click" />
                                        <TextBlock Text="Blender é necessário quando há modelos." Style="{StaticResource C2Hint}" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Expander>
                                <Border Height="1" Background="{DynamicResource Border}" Margin="0,15" />
                                <TextBlock Text="O que muda na qualidade?" Style="{StaticResource C2Label}" />
                                <TextBlock Text="A redução de modelos, imagens e áudio pode alterar a qualidade. A etapa exata preserva o resultado dessa redução."
                                           Style="{StaticResource C2Hint}" />
                                <TextBlock Text="{Binding Economy}" Style="{StaticResource C2Hint}" Margin="0,13,0,0" />
                                <Expander Header="Detalhes técnicos" Margin="0,15,0,0" FontSize="14">
                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Text="complete-safe-native-exact/v1" Style="{StaticResource HintText}" />
                                        <TextBlock Text="Models Safe; VTF/PNG 2x/min8; WAV PCM16 44100 → 22050 quando elegível. A distribuição exata é obrigatória neste fluxo." Style="{StaticResource C2Hint}" Margin="0,10,0,0" />
                                        <TextBlock Text="DX80/SW ficam fora da seleção de distribuição; DX90 é preservado. Exclusões são contabilizadas separadamente." Style="{StaticResource C2Hint}" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Border Grid.Row="3" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="24,6">
                    <Expander x:Name="Expander_FullActivity" IsExpanded="False" FontSize="13" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <DockPanel>
                                <TextBlock Text="Atividade" FontWeight="SemiBold" Margin="0,0,18,0" />
                                <TextBlock x:Name="TextBlock_FullStatus" Text="Aguardando addon. Seus originais não serão alterados."
                                           Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="650" />
                            </DockPanel>
                        </Expander.Header>
                        <TextBox x:Name="TextBox_FullLog" Style="{StaticResource LogTextBox}" Height="48" Margin="0,6,0,0"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"  VerticalContentAlignment="Top"/>
                    </Expander>
                </Border>

                <Border Grid.Row="4" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{Binding NextStep}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="Originais preservados · saída em uma pasta nova" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="Button_FullOpenWork" Content="Relatórios e logs" Click="Button_FullOpenWork_Click" IsEnabled="False" Margin="0,0,10,0">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ButtonDefault}"><Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers></Style></Button.Style>
                            </Button>
                            <Button x:Name="Button_FullStart" Click="Button_FullStart_Click" IsEnabled="{Binding CanEdit}">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ButtonAccent}">
                                    <Setter Property="Content" Value="Comprimir addon completo" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Content" Value="Escolher addon original…" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsResult}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style></Button.Style>
                            </Button>
                            <Button x:Name="Button_FullCancel" Content="Solicitar cancelamento" Click="Button_FullCancel_Click" IsEnabled="False"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button x:Name="Button_FullOpenOutput" Style="{StaticResource ButtonAccent}" Content="Abrir candidato" Click="Button_FullOpenOutput_Click" IsEnabled="False"
                                    Visibility="{Binding IsResult, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
        <TabItem Header="Modelos" x:Name="Tab_Models">
            <Grid Background="{DynamicResource AppBackground}" TextElement.Foreground="{DynamicResource TextPrimary}">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="880" Margin="32,22,32,24">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Modelos" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Reduz só os modelos (.mdl). O addon original não muda; o resultado vai para uma pasta nova." />

                        <!-- Addon -->
                        <Border Style="{StaticResource M3Card}" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Addon" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Pasta do addon" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox IsReadOnly="True" Text="{Binding AddonDirectoryPath}" Height="44" Padding="12,0"
                                             VerticalContentAlignment="Center" HorizontalScrollBarVisibility="Hidden"
                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                             AutomationProperties.Name="Pasta do addon" />
                                    <Button x:Name="Button_SelectDirectoryModels" Grid.Column="1" Style="{StaticResource OutlinedButton}"
                                            Content="Escolher…" Margin="8,0,0,0" IsEnabled="{Binding UnlockedUI}" />
                                </Grid>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Sufixo da pasta de saída" />
                                        <TextBox Text="{Binding OptimizerSuffix, UpdateSourceTrigger=PropertyChanged}" Height="44" Padding="12,0"
                                                 VerticalContentAlignment="Center" HorizontalScrollBarVisibility="Hidden"
                                                 AutomationProperties.Name="Sufixo da pasta de saída" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding OptimizerOverwrite}" Margin="20,0,0,10" VerticalAlignment="Bottom">
                                        <TextBlock Text="Substituir a pasta de saída se já existir" TextWrapping="Wrap" />
                                    </CheckBox>
                                </Grid>
                                <TextBlock Style="{StaticResource FieldHint}" Text="O resultado fica ao lado do addon, com esse sufixo no nome." />

                                <Border BorderBrush="{DynamicResource Danger}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,14,0,0"
                                        Visibility="{Binding AddonWorkshopWarningVisibility}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource Danger}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding AddonWorkshopWarningHeaderText}" FontWeight="SemiBold" Foreground="{DynamicResource Danger}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource FieldHint}" Text="O addon ainda aponta para conteúdo da Workshop. Revise antes de publicar." />
                                        <Expander Style="{StaticResource M3Expander}" Header="Ver onde" Background="{DynamicResource Surface2}">
                                            <TextBox Text="{Binding AddonWorkshopWarningText}" Style="{StaticResource ReportTextBox}"
                                                     MinHeight="72" VerticalContentAlignment="Top" />
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Método -->
                        <Border Style="{StaticResource M3Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Método" />
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource ChoiceChip}" GroupName="ModelsMode" Content="Padrão (recomendado)"
                                                 IsChecked="{Binding OptimizerModeScreenChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="2,0,0,0"
                                           Text="Reduz cada modelo conforme o quanto ele aparece na tela do jogo. Edita os arquivos direto, sem Blender." />

                                <StackPanel Margin="0,16,0,0" Visibility="{Binding OptimizerModeIsScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Perfil" />
                                    <WrapPanel>
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="ModelsProfile" Content="Sem perda"
                                                     IsChecked="{Binding ModelsScreenProfileIndex, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=4, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="ModelsProfile" Content="Equilibrado"
                                                     IsChecked="{Binding ModelsScreenProfileIndex, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=0, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="ModelsProfile" Content="Forte"
                                                     IsChecked="{Binding ModelsScreenProfileIndex, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=1, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="ModelsProfile" Content="Forte + espelho"
                                                     IsChecked="{Binding ModelsScreenProfileIndex, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=2, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="ModelsProfile" Content="Stream (experimental)"
                                                     IsChecked="{Binding ModelsScreenProfileIndex, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=3, Mode=TwoWay}" />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource FieldHint}" Margin="2,0,0,0" Text="{Binding OptimizerModeDescriptionText}" />
                                </StackPanel>

                                <Border Background="{DynamicResource SecondaryContainer}" CornerRadius="8" Padding="12,8" Margin="0,14,0,0"
                                        Visibility="{Binding OptimizerModeIsLegacy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding OptimizerLegacyModeNotice}" Foreground="{DynamicResource OnSecondaryContainer}" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Modos antigos com Blender -->
                        <Expander Style="{StaticResource M3Expander}" Header="Recompilar com Blender (antigo)"
                                  IsExpanded="{Binding OptimizerModeIsLegacy, Mode=OneWay}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="2,0,0,14"
                                           Text="Descompilam, reduzem e recompilam cada modelo com Blender e studiomdl. Mais lentos que o Padrão." />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Modo" />
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource ChoiceChip}" GroupName="ModelsMode" Content="Normal"
                                                 IsChecked="{Binding OptimizerModeNormalChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <RadioButton Style="{StaticResource ChoiceChip}" GroupName="ModelsMode" Content="Fidelidade"
                                                 IsChecked="{Binding OptimizerModeFidelityChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <RadioButton Style="{StaticResource ChoiceChip}" GroupName="ModelsMode" Content="Maximum"
                                                 IsChecked="{Binding OptimizerModeMaximumChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="2,0,0,0" Text="{Binding OptimizerModeDescriptionText}"
                                           Visibility="{Binding OptimizerModeIsLegacy, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <!-- Ferramentas -->
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Blender" Margin="2,18,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding BlenderPath, UpdateSourceTrigger=PropertyChanged}" Height="44" Padding="12,0"
                                             VerticalContentAlignment="Center" HorizontalScrollBarVisibility="Hidden"
                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Caminho do Blender" />
                                    <Button x:Name="Button_AutoDetectBlender" Grid.Column="1" Style="{StaticResource TextButton}" Content="Detectar"
                                            Margin="8,0,0,0" IsEnabled="{Binding UnlockedUI}" />
                                    <Button x:Name="Button_BrowseBlender" Grid.Column="2" Style="{StaticResource OutlinedButton}" Content="Escolher…"
                                            Margin="4,0,0,0" IsEnabled="{Binding UnlockedUI}" />
                                </Grid>
                                <TextBlock Margin="2,6,0,0" FontSize="12" Text="Caminho não informado" Foreground="{DynamicResource Warning}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BlenderPath}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding BlenderPath}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="studiomdl" Margin="2,14,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding StudioMdlPath, UpdateSourceTrigger=PropertyChanged}" Height="44" Padding="12,0"
                                             VerticalContentAlignment="Center" HorizontalScrollBarVisibility="Hidden"
                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="Caminho do studiomdl" />
                                    <Button x:Name="Button_AutoDetectStudioMdl" Grid.Column="1" Style="{StaticResource TextButton}" Content="Detectar"
                                            Margin="8,0,0,0" IsEnabled="{Binding UnlockedUI}" />
                                    <Button x:Name="Button_BrowseStudioMdl" Grid.Column="2" Style="{StaticResource OutlinedButton}" Content="Escolher…"
                                            Margin="4,0,0,0" IsEnabled="{Binding UnlockedUI}" />
                                </Grid>
                                <TextBlock Margin="2,6,0,0" FontSize="12" Text="Caminho não informado" Foreground="{DynamicResource Warning}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StudioMdlPath}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StudioMdlPath}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Preset e ajuste fino -->
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Preset" Margin="2,18,0,6" />
                                <ComboBox x:Name="ComboBox_OptimizerPreset" Width="260" HorizontalAlignment="Left"
                                          ItemsSource="{Binding OptimizerPresetList}" SelectedIndex="{Binding OptimizerPresetIndex}"
                                          AutomationProperties.Name="Preset" />
                                <TextBlock Style="{StaticResource FieldHint}" Text="Seguro reduz menos e arrisca menos; Personalizado libera os campos abaixo." />

                                <Grid Margin="0,12,0,0" IsEnabled="{Binding OptimizerPresetIsCustom}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Proporção" />
                                        <TextBox Text="{Binding OptimizerRatio, Converter={StaticResource OptimizerRatioConverter}, UpdateSourceTrigger=LostFocus}"
                                                 Height="40" Padding="12,0" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Mesclar" />
                                        <TextBox Text="{Binding OptimizerMerge, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="12,0" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Suavização (graus)" />
                                        <TextBox Text="{Binding OptimizerAutoSmooth, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="12,0" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Formato" />
                                        <ComboBox ItemsSource="{Binding OptimizerFormatList}" SelectedIndex="{Binding OptimizerFormatIndex}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,10,8,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Processos" />
                                        <TextBox Text="{Binding OptimizerJobs, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="12,0" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,10,4,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Descompilação" />
                                        <TextBox Text="{Binding OptimizerDecompileJobs, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="12,0" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,10,4,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Compilação" />
                                        <TextBox Text="{Binding OptimizerCompileJobs, UpdateSourceTrigger=PropertyChanged}" Height="40" Padding="12,0" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- Opções dos modos antigos -->
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Opções" Margin="2,18,0,6" />
                                <UniformGrid Columns="2">
                                    <CheckBox IsChecked="{Binding OptimizerUseVtxTriStrips}" Margin="0,0,12,8">
                                        <TextBlock Text="Compactar VTX (TRI_STRIP)" TextWrapping="Wrap" />
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding OptimizerRestoreSkins}" Margin="0,0,0,8">
                                        <TextBlock Text="Restaurar skins (mais lento)" TextWrapping="Wrap" />
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding OptimizerStrict}" Margin="0,0,12,8">
                                        <TextBlock Text="Parar no primeiro erro" TextWrapping="Wrap" />
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding OptimizerResumeOpt}" Margin="0,0,0,8">
                                        <TextBlock Text="Continuar execução anterior" TextWrapping="Wrap" />
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding OptimizerOverwriteWork}" Margin="0,0,12,8">
                                        <TextBlock Text="Substituir a pasta de trabalho" TextWrapping="Wrap" />
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding OptimizerCompileVerbose}" Margin="0,0,0,8">
                                        <TextBlock Text="Log completo do studiomdl (mais lento)" TextWrapping="Wrap" />
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding OptimizerCleanupWorkModelArtifacts}" Margin="0,0,12,8">
                                        <TextBlock Text="Limpar arquivos pesados da pasta de trabalho no fim" TextWrapping="Wrap" />
                                    </CheckBox>
                                </UniformGrid>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Experimentais (só no Normal)" Margin="2,12,0,6" />
                                <CheckBox IsEnabled="{Binding OptimizerModeIsNormal}" IsChecked="{Binding OptimizerUseExperimentalGroundPolicy}" Margin="0,0,0,8">
                                    <TextBlock Text="Corrigir o sombreado da carroceria de veículos terrestres" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox IsEnabled="{Binding OptimizerModeIsNormal}" IsChecked="{Binding OptimizerUseExperimentalRoundPartsPolicy}" Margin="0,0,0,8">
                                    <TextBlock Text="Preservar peças redondas (rodas, volantes, mostradores)" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox IsEnabled="{Binding OptimizerModeIsNormal}" IsChecked="{Binding OptimizerUseExperimentalSteerTurnBasisFix}" Margin="0,0,0,8">
                                    <TextBlock Text="Corrigir o giro do volante" TextWrapping="Wrap" />
                                </CheckBox>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding OptimizerUsePlanar}" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Passo planar antes de reduzir; ângulo:" TextWrapping="Wrap" />
                                    </CheckBox>
                                    <TextBox Grid.Column="1" Text="{Binding OptimizerPlanarAngle, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding OptimizerUsePlanar}" Height="40" Padding="12,0" VerticalContentAlignment="Center"
                                             AutomationProperties.Name="Ângulo do passo planar" />
                                </Grid>

                                <!-- Perfil gravado no jogo (Maximum v2) -->
                                <Border x:Name="ModelsCompanionProfileCard" Background="{DynamicResource Surface2}" CornerRadius="12" Padding="14,12" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Perfil gravado no jogo (opcional, só Maximum)" FontWeight="SemiBold" />
                                        <CheckBox Margin="0,8,0,0"
                                                  IsChecked="{Binding UseWithMaximumV2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Content="Usar com o Maximum v2" IsEnabled="{Binding CanUseWithMaximumV2}" />
                                        <TextBlock Style="{StaticResource FieldHint}" Text="{Binding ProfileCompatibilityText}" />
                                        <TextBlock Style="{StaticResource FieldHint}" Margin="2,2,0,0" Text="{Binding ProfileMatchText}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- Andamento -->
                        <Border Style="{StaticResource M3Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Andamento" />
                                <TextBlock Text="{Binding ModelsStatusText}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ModelsStatusText}" Value="">
                                                    <Setter Property="Text" Value="Pronto para começar." />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ModelsStatusText}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="Pronto para começar." />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ProgressBar x:Name="ProgressBar_Models" Height="6" Margin="0,12,0,8"
                                             Minimum="{Binding ModelsProgressMinValue}"
                                             Maximum="{Binding ModelsProgressMaxValue}"
                                             Value="{Binding ModelsProgressValue}" />
                                <TextBlock Text="{Binding ModelsProgressText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                <Expander Header="Relatório de tamanho" Background="{DynamicResource Surface2}">
                                    <Expander.Style>
                                        <Style TargetType="Expander" BasedOn="{StaticResource M3Expander}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ModelsSizeReportText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ModelsSizeReportText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Expander.Style>
                                    <TextBox Text="{Binding ModelsSizeReportText}" Style="{StaticResource ReportTextBox}" MinHeight="120" VerticalContentAlignment="Top" />
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Rodapé -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="32,14">
                    <Grid MaxWidth="880">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="Button_OpenModelsOutput" Style="{StaticResource TextButton}" Content="Abrir pasta" IsEnabled="False" />
                            <Button x:Name="Button_OpenModelsWork" Style="{StaticResource TextButton}" Content="Pasta de trabalho" IsEnabled="False" Margin="4,0,0,0" />
                            <Button x:Name="Button_OpenModelsLogs" Style="{StaticResource TextButton}" Content="Logs" IsEnabled="False" Margin="4,0,0,0" />
                        </StackPanel>
                        <Button x:Name="Button_OptimizeModels" Style="{StaticResource FilledButton}" HorizontalAlignment="Right" IsEnabled="{Binding UnlockedUI}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Otimizar modelos" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
        <TabItem Header="Texturas e sons" x:Name="Tab_Media">
            <Grid Background="{DynamicResource AppBackground}" TextElement.Foreground="{DynamicResource TextPrimary}">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="880" Margin="32,22,32,24">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Texturas e sons" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Reduz texturas, imagens e sons. Atenção: esta tela altera os arquivos da própria pasta escolhida; use uma cópia." />

                        <!-- Addon -->
                        <Border Style="{StaticResource M3Card}" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Addon" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Pasta do addon (será alterada)" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TextBox_DirectoryPath" IsReadOnly="True" Text="{Binding AddonDirectoryPath}" Height="44" Padding="12,0"
                                             VerticalContentAlignment="Center" HorizontalScrollBarVisibility="Hidden"
                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                             AutomationProperties.Name="Pasta do addon" />
                                    <Button x:Name="Button_SelectDirectory" Grid.Column="1" Style="{StaticResource OutlinedButton}"
                                            Content="Escolher…" Margin="8,0,0,0" IsEnabled="{Binding UnlockedUI}" />
                                </Grid>

                                <Border BorderBrush="{DynamicResource Danger}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,14,0,0"
                                        Visibility="{Binding AddonWorkshopWarningVisibility}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource Danger}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding AddonWorkshopWarningHeaderText}" FontWeight="SemiBold" Foreground="{DynamicResource Danger}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource FieldHint}" Text="O addon ainda aponta para conteúdo da Workshop. Revise antes de publicar." />
                                        <Expander Style="{StaticResource M3Expander}" Header="Ver onde" Background="{DynamicResource Surface2}">
                                            <TextBox Text="{Binding AddonWorkshopWarningText}" Style="{StaticResource ReportTextBox}"
                                                     MinHeight="72" VerticalContentAlignment="Top" />
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Tipos de arquivo -->
                        <Border Style="{StaticResource M3Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Tipos de arquivo" />
                                <UniformGrid Columns="4">
                                    <CheckBox IsChecked="{Binding CompressVTF}" Margin="0,0,0,8"><TextBlock Text="VTF" /></CheckBox>
                                    <CheckBox IsChecked="{Binding CompressPNG}" Margin="0,0,0,8"><TextBlock Text="PNG" /></CheckBox>
                                    <CheckBox IsChecked="{Binding CompressJPG}" Margin="0,0,0,8"><TextBlock Text="JPG" /></CheckBox>
                                    <CheckBox IsChecked="{Binding CompressLUA}" Margin="0,0,0,8"><TextBlock Text="Lua (minificar)" /></CheckBox>
                                    <CheckBox IsChecked="{Binding CompressWAV}" Margin="0,0,0,8"><TextBlock Text="WAV" /></CheckBox>
                                    <CheckBox IsChecked="{Binding CompressMP3}" Margin="0,0,0,8"><TextBlock Text="MP3" /></CheckBox>
                                    <CheckBox IsChecked="{Binding CompressOGG}" Margin="0,0,0,8"><TextBlock Text="OGG" /></CheckBox>
                                </UniformGrid>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="2,0,0,0" Text="Tipos desmarcados ficam como estão." />
                            </StackPanel>
                        </Border>

                        <!-- Texturas (VTF) -->
                        <Border Style="{StaticResource M3Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Texturas (VTF)" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Modo" />
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CompressMode" Content="Padrão (recomendado)"
                                                 IsChecked="{Binding CompressModeIndex, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=4, Mode=TwoWay}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="2,0,0,0"
                                           Text="Reduz cada textura conforme o quanto ela aparece na tela do jogo." />

                                <StackPanel Margin="0,16,0,0" Visibility="{Binding CompressModeIsScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Perfil" />
                                    <WrapPanel>
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CompressScreenProfile" Content="Sem perda"
                                                     IsChecked="{Binding CompressScreenProfileIndex, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=3, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CompressScreenProfile" Content="Equilibrado"
                                                     IsChecked="{Binding CompressScreenProfileIndex, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=0, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CompressScreenProfile" Content="Forte"
                                                     IsChecked="{Binding CompressScreenProfileIndex, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=1, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CompressScreenProfile" Content="Máximo"
                                                     IsChecked="{Binding CompressScreenProfileIndex, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=2, Mode=TwoWay}" />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource FieldHint}" Margin="2,0,0,0" Text="{Binding CompressScreenProfileHint}" />
                                </StackPanel>

                                <Border Background="{DynamicResource SecondaryContainer}" CornerRadius="8" Padding="12,8" Margin="0,14,0,0"
                                        Visibility="{Binding CompressModeIsLegacy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding CompressLegacyModeNotice}" Foreground="{DynamicResource OnSecondaryContainer}" TextWrapping="Wrap" />
                                </Border>

                                <Expander Style="{StaticResource M3Expander}" Header="Modos antigos" Background="{DynamicResource Surface2}"
                                          IsExpanded="{Binding CompressModeIsLegacy, Mode=OneWay}">
                                    <StackPanel>
                                        <WrapPanel>
                                            <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CompressMode" Content="Clássico"
                                                         IsChecked="{Binding CompressModeIndex, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=0, Mode=TwoWay}" />
                                            <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CompressMode" Content="Magick"
                                                         IsChecked="{Binding CompressModeIndex, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=1, Mode=TwoWay}" />
                                            <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CompressMode" Content="Maximum"
                                                         IsChecked="{Binding CompressModeIndex, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=2, Mode=TwoWay}" />
                                            <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CompressMode" Content="Magick+"
                                                         IsChecked="{Binding CompressModeIndex, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=3, Mode=TwoWay}" />
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource FieldHint}" Margin="2,0,0,0" Text="{Binding CompressModeDescriptionText}"
                                                   Visibility="{Binding CompressModeIsLegacy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <CheckBox Margin="0,12,0,0" IsChecked="{Binding CompressMagickUseAggressivePng}" IsEnabled="{Binding CompressPNG}"
                                                  Visibility="{Binding CompressMagickOptionsVisibility}">
                                            <TextBlock Text="PNG agressivo (q256): menor, perde mais" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <StackPanel Margin="0,12,0,0" Visibility="{Binding CompressMaximumOptionsVisibility}">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Decisão atual" />
                                            <TextBlock Text="{Binding CompressMaximumStatusText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="2,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource FieldHint}" Margin="2,12,0,0"
                                                   Text="O fator e os limites de tamanho dos modos antigos ficam em Redução de imagens, abaixo." />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- Redução de imagens (PNG, JPG e modos antigos) -->
                        <Expander Style="{StaticResource M3Expander}" Header="Redução de imagens (PNG, JPG e modos antigos)">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="2,0,0,12"
                                           Text="Fator de redução e tamanho mínimo. Uma imagem nunca fica menor que o limite." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Reduzir (vezes)" />
                                        <ComboBox ItemsSource="{Binding ImageReducingResolutionList, Mode=OneTime}"
                                                  SelectedIndex="{Binding ImageReducingResolutionListIndex, Mode=TwoWay}" AutomationProperties.Name="Fator de redução" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Largura mínima" />
                                        <ComboBox ItemsSource="{Binding ImageSizeLimitList, Mode=OneTime}"
                                                  SelectedIndex="{Binding ImageWidthLimitIndex, Mode=TwoWay}" AutomationProperties.Name="Largura mínima" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Altura mínima" />
                                        <ComboBox ItemsSource="{Binding ImageSizeLimitList, Mode=OneTime}"
                                                  SelectedIndex="{Binding ImageHeightLimitIndex, Mode=TwoWay}" AutomationProperties.Name="Altura mínima" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Ignorar imagens com largura até" />
                                        <TextBox Text="{Binding ImageSkipWidth}" Height="40" Padding="12,0" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Ignorar imagens com altura até" />
                                        <TextBox Text="{Binding ImageSkipHeight}" Height="40" Padding="12,0" VerticalContentAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox Margin="0,12,0,0" IsChecked="{Binding ReduceExactlyToLimits}">
                                    <TextBlock Text="Reduzir exatamente até o limite" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox Margin="0,8,0,0" IsChecked="{Binding KeepImageAspectRatio}">
                                    <TextBlock Text="Manter a proporção da imagem" TextWrapping="Wrap" />
                                </CheckBox>
                            </StackPanel>
                        </Expander>

                        <!-- Sons -->
                        <Border Style="{StaticResource M3Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Sons" />
                                <TextBlock Style="{StaticResource FieldHint}" Margin="2,0,0,0" Visibility="{Binding CompressNoAudioProfileVisibility}"
                                           Text="Marque WAV, MP3 ou OGG em Tipos de arquivo para ajustar os sons." />

                                <StackPanel Visibility="{Binding CompressWavProfileVisibility}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="WAV" />
                                    <WrapPanel>
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="WavProfile" Content="Manual"
                                                     IsChecked="{Binding WavOptimizationIndex, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=0, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource ChoiceChip}" GroupName="WavProfile" Content="Adaptativo conservador"
                                                     IsChecked="{Binding WavOptimizationIndex, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=1, Mode=TwoWay}" />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource FieldHint}" Margin="2,0,0,10"
                                               Text="Manual usa exatamente os valores abaixo. Adaptativo usa esses valores como referência e só troca um som quando ele fica menor sem piorar." />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Taxa (Hz)" />
                                            <ComboBox ItemsSource="{Binding WavRateList, Mode=OneTime}" SelectedIndex="{Binding WavRateListIndex, Mode=TwoWay}"
                                                      AutomationProperties.Name="Taxa do WAV" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Canais" />
                                            <ComboBox ItemsSource="{Binding WavChannelList, Mode=OneTime}" SelectedIndex="{Binding WavChannelsIndex, Mode=TwoWay}"
                                                      AutomationProperties.Name="Canais do WAV" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Formato" />
                                            <ComboBox ItemsSource="{Binding WavCodecList, Mode=OneTime}" SelectedIndex="{Binding WavCodecIndex, Mode=TwoWay}"
                                                      AutomationProperties.Name="Formato do WAV" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Margin="0,12,0,0" IsChecked="{Binding AudioLoopSafe}">
                                        <TextBlock Text="Proteger loops (mantém os pontos de repetição)" TextWrapping="Wrap" />
                                    </CheckBox>
                                </StackPanel>

                                <StackPanel Margin="0,18,0,0" Visibility="{Binding CompressMp3ProfileVisibility}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="MP3" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Taxa (Hz)" />
                                            <ComboBox ItemsSource="{Binding WavRateList, Mode=OneTime}" SelectedIndex="{Binding Mp3RateIndex, Mode=TwoWay}"
                                                      AutomationProperties.Name="Taxa do MP3" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Bitrate (kbps)" />
                                            <ComboBox ItemsSource="{Binding AudioBitrateList, Mode=OneTime}" SelectedIndex="{Binding Mp3BitrateIndex, Mode=TwoWay}"
                                                      AutomationProperties.Name="Bitrate do MP3" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource FieldHint}" Text="Evite MP3 em sons que repetem em loop." />
                                </StackPanel>

                                <StackPanel Margin="0,18,0,0" Visibility="{Binding CompressOggProfileVisibility}">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="OGG" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Taxa (Hz)" />
                                            <ComboBox ItemsSource="{Binding WavRateList, Mode=OneTime}" SelectedIndex="{Binding OggRateIndex, Mode=TwoWay}"
                                                      AutomationProperties.Name="Taxa do OGG" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Qualidade" />
                                            <ComboBox ItemsSource="{Binding OggQualityList, Mode=OneTime}" SelectedIndex="{Binding OggQualityIndex, Mode=TwoWay}"
                                                      AutomationProperties.Name="Qualidade do OGG" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Canais" />
                                            <ComboBox ItemsSource="{Binding WavChannelList, Mode=OneTime}" SelectedIndex="{Binding OggChannelsIndex, Mode=TwoWay}"
                                                      AutomationProperties.Name="Canais do OGG" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Andamento -->
                        <Border Style="{StaticResource M3Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Andamento" />
                                <TextBlock TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Pronto para começar." />
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UnlockedUI}" Value="False">
                                                    <Setter Property="Text" Value="Trabalhando…" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ProgressBar x:Name="ProgressBar_Compress" Height="6" Margin="0,12,0,8"
                                             Minimum="{Binding ProgressBarMinValue}"
                                             Maximum="{Binding ProgressBarMaxValue}"
                                             Value="{Binding ProgressBarValue}" />
                                <TextBlock Text="{Binding ProgressBarText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                <Expander Style="{StaticResource M3Expander}" Header="Detalhes" Background="{DynamicResource Surface2}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Caminho de cada tipo" />
                                        <TextBlock Text="{Binding CompressModeRoutingText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="2,0,0,12" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Relatório de tamanho" />
                                        <TextBox Text="{Binding CompressSizeReportText}" Style="{StaticResource ReportTextBox}" MinHeight="110" VerticalContentAlignment="Top" />
                                        <CheckBox x:Name="CheckBox_DebugConsole" Margin="0,12,0,0"
                                                  Checked="CheckBox_EnableDebugConsole" Unchecked="CheckBox_DisableDebugConsole">
                                            <TextBlock Text="Abrir console de depuração" TextWrapping="Wrap" />
                                        </CheckBox>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Rodapé -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="32,14">
                    <Grid MaxWidth="880">
                        <TextBlock Text="Altera a pasta escolhida." FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <Button x:Name="Button_Compress" Style="{StaticResource FilledButton}" HorizontalAlignment="Right" IsEnabled="{Binding UnlockedUI}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Comprimir" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
        <TabItem Header="Descompactar" x:Name="Tab_Unpack">
            <Grid Background="{DynamicResource AppBackground}" TextElement.Foreground="{DynamicResource TextPrimary}">
                <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="880" Margin="32,22,32,24">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Descompactar" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Extrai arquivos .gma e .bin para pastas que dá para editar e otimizar." />

                        <!-- Pastas -->
                        <Border Style="{StaticResource M3Card}" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Pastas" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Pasta com .gma e .bin" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="TextBox_UnpackRootPath"
                                             TextChanged="TextBox_UnpackRootPath_TextChanged"
                                             Height="44" Padding="12,0" VerticalContentAlignment="Center"
                                             HorizontalScrollBarVisibility="Hidden" TextWrapping="NoWrap"
                                             AutomationProperties.Name="Pasta com .gma e .bin"
                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <Button x:Name="Button_SelectUnpackRoot" Grid.Column="1" Margin="8,0,0,0"
                                            Style="{StaticResource OutlinedButton}" Content="Escolher…"
                                            Click="Button_SelectUnpackRoot_Click" />
                                </Grid>

                                <TextBlock Style="{StaticResource FieldLabel}" Margin="2,16,0,6" Text="Salvar em (opcional)" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="TextBox_UnpackOutputRoot"
                                             TextChanged="TextBox_UnpackOutputRoot_TextChanged"
                                             Height="44" Padding="12,0" VerticalContentAlignment="Center"
                                             HorizontalScrollBarVisibility="Hidden" TextWrapping="NoWrap"
                                             AutomationProperties.Name="Salvar em"
                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource OutlinedButton}" Content="Escolher…"
                                            Click="Button_SelectUnpackOutputRoot_Click" />
                                    <Button Grid.Column="2" Margin="4,0,0,0" Style="{StaticResource TextButton}" Content="Usar a mesma pasta"
                                            Click="Button_UnpackUseRootOutput_Click" />
                                </Grid>
                                <TextBlock Style="{StaticResource FieldHint}" Text="Vazio: cada arquivo vira uma pasta _extraido ao lado dele." />
                            </StackPanel>
                        </Border>

                        <!-- Opções -->
                        <Border Style="{StaticResource M3Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Opções" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Se a pasta já existir" />
                                <ComboBox x:Name="ComboBox_UnpackExistingMode" Width="240" HorizontalAlignment="Left"
                                          AutomationProperties.Name="Se a pasta já existir">
                                    <ComboBoxItem Tag="skip" Content="Pular" />
                                    <ComboBoxItem Tag="overwrite" Content="Substituir" />
                                    <ComboBoxItem Tag="fail" Content="Parar" />
                                </ComboBox>

                                <CheckBox x:Name="CheckBox_UnpackExtractMapPak" Margin="0,16,0,0" IsChecked="True">
                                    <TextBlock Text="Extrair o conteúdo dos mapas (.bsp)" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox x:Name="CheckBox_UnpackDeleteMapBsp" Margin="0,8,0,0" IsChecked="False">
                                    <TextBlock Text="Apagar o .bsp depois de extrair o conteúdo" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox x:Name="CheckBox_UnpackOpenOnFinish" Margin="0,8,0,0">
                                    <TextBlock Text="Abrir a pasta ao terminar" TextWrapping="Wrap" />
                                </CheckBox>

                                <TextBlock Style="{StaticResource FieldLabel}" Margin="2,18,0,6" Text="gmad.exe (fica na pasta bin do Garry's Mod)" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="TextBox_UnpackGmadPath"
                                             TextChanged="TextBox_UnpackGmadPath_TextChanged"
                                             Height="44" Padding="12,0" VerticalContentAlignment="Center"
                                             HorizontalScrollBarVisibility="Hidden" TextWrapping="NoWrap"
                                             AutomationProperties.Name="Caminho do gmad.exe"
                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <Button x:Name="Button_AutoDetectGmad" Grid.Column="1" Margin="8,0,0,0"
                                            Style="{StaticResource TextButton}" Content="Detectar"
                                            Click="Button_AutoDetectGmad_Click" />
                                    <Button x:Name="Button_BrowseGmad" Grid.Column="2" Margin="4,0,0,0"
                                            Style="{StaticResource OutlinedButton}" Content="Escolher…"
                                            Click="Button_BrowseGmad_Click" />
                                </Grid>
                                <TextBlock Style="{StaticResource FieldHint}" Text="Só é preciso para descompactar. Procurar funciona sem ele." />
                            </StackPanel>
                        </Border>

                        <!-- Encontrados -->
                        <Border Style="{StaticResource M3Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Encontrados" />
                                <UniformGrid Columns="4">
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="Arquivos" />
                                        <TextBlock x:Name="TextBlock_UnpackFoundCount" Style="{StaticResource StatValue}" Text="0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text=".gma suportados" />
                                        <TextBlock x:Name="TextBlock_UnpackGmaCount" Style="{StaticResource StatValue}" Text="0/0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text=".bin suportados" />
                                        <TextBlock x:Name="TextBlock_UnpackBinSupportedCount" Style="{StaticResource StatValue}" Text="0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text=".bin não suportados" />
                                        <TextBlock x:Name="TextBlock_UnpackBinUnsupportedCount" Style="{StaticResource StatValue}" Text="0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="Extraídos" />
                                        <TextBlock x:Name="TextBlock_UnpackOkCount" Style="{StaticResource StatValue}" Text="0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="Pulados" />
                                        <TextBlock x:Name="TextBlock_UnpackSkippedCount" Style="{StaticResource StatValue}" Text="0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="Com falha" />
                                        <TextBlock x:Name="TextBlock_UnpackFailedCount" Style="{StaticResource StatValue}" Text="0" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="2,12,0,8"
                                           Text="Um .bin só é suportado quando tem um .gma dentro. Os outros são listados e o lote continua." />
                                <TextBox x:Name="TextBox_UnpackSummary" Style="{StaticResource ReportTextBox}" MinHeight="72"
                                         VerticalContentAlignment="Top" AutomationProperties.Name="Resumo da descompactação" />
                            </StackPanel>
                        </Border>

                        <!-- Andamento -->
                        <Border Style="{StaticResource M3Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Andamento" />
                                <TextBlock x:Name="TextBlock_UnpackStatus" FontSize="16" FontWeight="SemiBold" Text="Aguardando" TextWrapping="Wrap" />
                                <ProgressBar x:Name="ProgressBar_Unpack" Height="6" Margin="0,12,0,12" Minimum="0" Maximum="100" Value="0" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0" Text="Etapa" />
                                    <TextBlock x:Name="TextBlock_UnpackPhase" Grid.Column="1" Foreground="{DynamicResource TextSecondary}" Text="—" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" Text="Agora" />
                                    <TextBlock x:Name="TextBlock_UnpackCurrent" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextSecondary}" Text="—" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                </Grid>
                                <Expander Style="{StaticResource M3Expander}" Header="Detalhes" Background="{DynamicResource Surface2}">
                                    <TextBox x:Name="TextBox_UnpackLog" Style="{StaticResource LogTextBox}" Height="220"
                                             VerticalContentAlignment="Top" AutomationProperties.Name="Log da descompactação" />
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="32,14">
                    <Grid MaxWidth="880">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="Button_UnpackOpenRoot" Style="{StaticResource TextButton}" Content="Abrir pasta"
                                    Click="Button_UnpackOpenRoot_Click" IsEnabled="False" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="Button_UnpackCancel" Style="{StaticResource OutlinedButton}" Content="Cancelar" Margin="0,0,8,0"
                                    Click="Button_UnpackCancel_Click" IsEnabled="False" />
                            <Button x:Name="Button_UnpackScan" Style="{StaticResource TonalButton}" Content="Procurar" Margin="0,0,8,0"
                                    Click="Button_UnpackScan_Click" />
                            <Button x:Name="Button_UnpackRun" Style="{StaticResource FilledButton}" Content="Descompactar"
                                    Click="Button_UnpackRun_Click" IsEnabled="False" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
        <TabItem Header="Juntar addons" x:Name="Tab_Merge">
            <Grid Background="{DynamicResource AppBackground}" TextElement.Foreground="{DynamicResource TextPrimary}">
                <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="880" Margin="32,22,32,24">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Juntar addons" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Une os addons de uma pasta em um addon só." />

                        <!-- Origem e destino -->
                        <Border Style="{StaticResource M3Card}" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Pastas" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Pasta com os addons" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="TextBox_AddonMergeRootPath"
                                             TextChanged="TextBox_AddonMergeRootPath_TextChanged"
                                             Height="44" Padding="12,0" VerticalContentAlignment="Center"
                                             HorizontalScrollBarVisibility="Hidden" TextWrapping="NoWrap"
                                             AutomationProperties.Name="Pasta com os addons"
                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <Button x:Name="Button_SelectAddonMergeRoot" Grid.Column="1" Margin="8,0,0,0"
                                            Style="{StaticResource OutlinedButton}" Content="Escolher…"
                                            Click="Button_SelectAddonMergeRoot_Click" />
                                </Grid>
                                <TextBlock Style="{StaticResource FieldHint}" Text="Pastas com ID da Workshop e pastas _extraido também entram." />

                                <TextBlock Style="{StaticResource FieldLabel}" Margin="2,16,0,6" Text="Nome do novo addon" />
                                <TextBox x:Name="TextBox_AddonMergeBundleName"
                                         TextChanged="TextBox_AddonMergeBundleName_TextChanged"
                                         Height="44" Padding="12,0" VerticalContentAlignment="Center"
                                         HorizontalScrollBarVisibility="Hidden" TextWrapping="NoWrap"
                                         AutomationProperties.Name="Nome do novo addon"
                                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                                <TextBlock Style="{StaticResource FieldLabel}" Margin="2,16,0,6" Text="Salvar em" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="TextBox_AddonMergeOutputRoot"
                                             TextChanged="TextBox_AddonMergeOutputRoot_TextChanged"
                                             Height="44" Padding="12,0" VerticalContentAlignment="Center"
                                             HorizontalScrollBarVisibility="Hidden" TextWrapping="NoWrap"
                                             AutomationProperties.Name="Salvar em"
                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource OutlinedButton}" Content="Escolher…"
                                            Click="Button_SelectAddonMergeOutputRoot_Click" />
                                    <Button Grid.Column="2" Margin="4,0,0,0" Style="{StaticResource TextButton}" Content="Usar a pasta de origem"
                                            Click="Button_AddonMergeUseRootOutput_Click" />
                                </Grid>
                                <TextBlock Style="{StaticResource FieldHint}" Text="Por padrão, o novo addon fica dentro da pasta de origem." />
                            </StackPanel>
                        </Border>

                        <!-- Conflitos -->
                        <Border Style="{StaticResource M3Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Conflitos" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Mesmo arquivo em dois addons" />
                                        <ComboBox x:Name="ComboBox_AddonMergeConflictPolicy" AutomationProperties.Name="Mesmo arquivo em dois addons">
                                            <ComboBoxItem Tag="first" Content="Manter o primeiro" />
                                            <ComboBoxItem Tag="last" Content="Manter o último" />
                                            <ComboBoxItem Tag="fail" Content="Parar" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Ordem dos addons" />
                                        <ComboBox x:Name="ComboBox_AddonMergePriorityMode" AutomationProperties.Name="Ordem dos addons">
                                            <ComboBoxItem Tag="name-asc" Content="Nome A–Z" />
                                            <ComboBoxItem Tag="name-desc" Content="Nome Z–A" />
                                            <ComboBoxItem Tag="discovery" Content="Ordem em que foram encontrados" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource FieldHint}" Text="A ordem decide quem é o primeiro. Os arquivos descartados aparecem no relatório." />
                            </StackPanel>
                        </Border>

                        <!-- Pacote .gma -->
                        <Border Style="{StaticResource M3Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Pacote .gma" />
                                <CheckBox x:Name="CheckBox_AddonMergeGenerateGma" IsChecked="False"
                                          Checked="CheckBox_AddonMergeGenerateGma_Changed"
                                          Unchecked="CheckBox_AddonMergeGenerateGma_Changed">
                                    <TextBlock Text="Gerar .gma no final" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Style="{StaticResource FieldHint}" Text="Desligado: só cria a pasta do addon unido." />

                                <TextBlock Style="{StaticResource FieldLabel}" Margin="2,16,0,6" Text="gmad.exe" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="TextBox_AddonMergeGmadPath"
                                             Text="{Binding ElementName=TextBox_UnpackGmadPath, Path=Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="TextBox_AddonMergeGmadPath_TextChanged"
                                             Height="44" Padding="12,0" VerticalContentAlignment="Center"
                                             HorizontalScrollBarVisibility="Hidden" TextWrapping="NoWrap"
                                             AutomationProperties.Name="Caminho do gmad.exe"
                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <Button x:Name="Button_AddonMergeAutoDetectGmad" Grid.Column="1" Margin="8,0,0,0"
                                            Style="{StaticResource TextButton}" Content="Detectar"
                                            Click="Button_AddonMergeAutoDetectGmad_Click" />
                                    <Button x:Name="Button_AddonMergeBrowseGmad" Grid.Column="2" Margin="4,0,0,0"
                                            Style="{StaticResource OutlinedButton}" Content="Escolher…"
                                            Click="Button_AddonMergeBrowseGmad_Click" />
                                </Grid>

                                <TextBlock Style="{StaticResource FieldLabel}" Margin="2,16,0,6" Text="Tipo de pacote" />
                                <ComboBox x:Name="ComboBox_AddonMergePackageMode" Width="320" HorizontalAlignment="Left"
                                          SelectionChanged="ComboBox_AddonMergePackageMode_SelectionChanged"
                                          AutomationProperties.Name="Tipo de pacote">
                                    <ComboBoxItem Tag="strict" Content="Estrito (recomendado)" />
                                    <ComboBoxItem Tag="compatibility" Content="Compatível" />
                                </ComboBox>
                                <TextBlock Style="{StaticResource FieldHint}" Text="Compatível descarta o que o gmad recusa (como models/*.sw.vtx) e lista no relatório." />
                            </StackPanel>
                        </Border>

                        <!-- Resultado -->
                        <Border Style="{StaticResource M3Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Resultado" />
                                <UniformGrid Columns="4">
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="Addons" />
                                        <TextBlock x:Name="TextBlock_AddonMergeAddonCount" Style="{StaticResource StatValue}" Text="0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="Arquivos" />
                                        <TextBlock x:Name="TextBlock_AddonMergeFileCount" Style="{StaticResource StatValue}" Text="0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="Caminhos únicos" />
                                        <TextBlock x:Name="TextBlock_AddonMergeUniquePathCount" Style="{StaticResource StatValue}" Text="0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="Conflitos" />
                                        <TextBlock x:Name="TextBlock_AddonMergeConflictCount" Style="{StaticResource StatValue}" Text="0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="Descartados" />
                                        <TextBlock x:Name="TextBlock_AddonMergeDiscardedCount" Style="{StaticResource StatValue}" Text="0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="Juntados" />
                                        <TextBlock x:Name="TextBlock_AddonMergeMergedFileCount" Style="{StaticResource StatValue}" Text="0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="Junção" />
                                        <TextBlock x:Name="TextBlock_AddonMergeMergeStatus" Text="—" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="Validação" />
                                        <TextBlock x:Name="TextBlock_AddonMergeValidationStatus" Text="—" TextWrapping="Wrap" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBox x:Name="TextBox_AddonMergeSummary" Style="{StaticResource ReportTextBox}" Margin="0,14,0,0" MinHeight="96"
                                         VerticalContentAlignment="Top" AutomationProperties.Name="Resumo da junção" />
                            </StackPanel>
                        </Border>

                        <!-- Andamento -->
                        <Border Style="{StaticResource M3Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Andamento" />
                                <DockPanel>
                                    <TextBlock x:Name="TextBlock_AddonMergeProgressPercent" DockPanel.Dock="Right" FontSize="16" Text="0%" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TextBlock_AddonMergeStatus" FontSize="16" FontWeight="SemiBold" Text="Aguardando" TextWrapping="Wrap" />
                                </DockPanel>
                                <ProgressBar x:Name="ProgressBar_AddonMerge" Height="6" Margin="0,12,0,8" Minimum="0" Maximum="100" Value="0" />
                                <TextBlock x:Name="TextBlock_AddonMergeProgressDetail" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           Text="Procure os addons para começar." TextWrapping="Wrap" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0" Text="Etapa" />
                                    <TextBlock x:Name="TextBlock_AddonMergePhase" Grid.Column="1" Foreground="{DynamicResource TextSecondary}" Text="—" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" Text="Agora" />
                                    <TextBlock x:Name="TextBlock_AddonMergeCurrent" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextSecondary}" Text="—" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                </Grid>
                                <Expander Style="{StaticResource M3Expander}" Header="Detalhes" Background="{DynamicResource Surface2}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Diagnóstico" />
                                        <TextBox x:Name="TextBox_AddonMergeDiagnostics" Style="{StaticResource ReportTextBox}" MinHeight="120"
                                                 VerticalContentAlignment="Top" AutomationProperties.Name="Diagnóstico da junção" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="2,14,0,6" Text="Log" />
                                        <TextBox x:Name="TextBox_AddonMergeLog" Style="{StaticResource LogTextBox}" Height="200"
                                                 VerticalContentAlignment="Top" AutomationProperties.Name="Log da junção" />
                                        <StackPanel Orientation="Horizontal" Margin="-12,10,0,0">
                                            <Button x:Name="Button_AddonMergeOpenReports" Style="{StaticResource TextButton}" Content="Ver relatórios"
                                                    Click="Button_AddonMergeOpenReports_Click" IsEnabled="False" />
                                            <Button x:Name="Button_AddonMergeOpenWork" Style="{StaticResource TextButton}" Content="Pasta de trabalho"
                                                    Click="Button_AddonMergeOpenWork_Click" IsEnabled="False" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="32,14">
                    <Grid MaxWidth="880">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="Button_AddonMergeOpenRoot" Style="{StaticResource TextButton}" Content="Abrir origem"
                                    Click="Button_AddonMergeOpenRoot_Click" IsEnabled="False" />
                            <Button x:Name="Button_AddonMergeOpenMerged" Style="{StaticResource TextButton}" Content="Abrir addon unido"
                                    Click="Button_AddonMergeOpenMerged_Click" IsEnabled="False" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="Button_AddonMergeCancel" Style="{StaticResource OutlinedButton}" Content="Cancelar" Margin="0,0,8,0"
                                    Click="Button_AddonMergeCancel_Click" IsEnabled="False" />
                            <Button x:Name="Button_AddonMergeScan" Style="{StaticResource TonalButton}" Content="Procurar" Margin="0,0,8,0"
                                    Click="Button_AddonMergeScan_Click" />
                            <Button x:Name="Button_AddonMergeRun" Style="{StaticResource FilledButton}" Content="Juntar"
                                    Click="Button_AddonMergeRun_Click" IsEnabled="False" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
        <TabItem Header="Mapas" x:Name="Tab_Maps">
            <Grid Background="{DynamicResource AppBackground}" TextElement.Foreground="{DynamicResource TextPrimary}">
                <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="880" Margin="32,22,32,24">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Mapas" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Otimiza as texturas e os sons que ficam dentro dos mapas (.bsp)." />

                        <!-- Addon -->
                        <Border Style="{StaticResource M3Card}" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Addon" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Pasta do addon com mapas" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="TextBox_MapScanRootPath"
                                             TextChanged="TextBox_MapScanRootPath_TextChanged"
                                             Height="44" Padding="12,0" VerticalContentAlignment="Center"
                                             HorizontalScrollBarVisibility="Hidden" TextWrapping="NoWrap"
                                             AutomationProperties.Name="Pasta do addon com mapas"
                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <Button x:Name="Button_SelectMapScanRoot" Grid.Column="1" Margin="8,0,0,0"
                                            Style="{StaticResource OutlinedButton}" Content="Escolher…"
                                            Click="Button_SelectMapScanRoot_Click" />
                                </Grid>
                                <TextBlock Style="{StaticResource FieldHint}" Text="Um addon já extraído (com maps/*.bsp) ou uma pasta com .gma/.bin." />

                                <TextBlock Style="{StaticResource FieldLabel}" Margin="2,16,0,6" Text="gmad.exe (só para pastas com .gma/.bin)" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="TextBox_MapGmadPath"
                                             Text="{Binding ElementName=TextBox_UnpackGmadPath, Path=Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Height="44" Padding="12,0" VerticalContentAlignment="Center"
                                             HorizontalScrollBarVisibility="Hidden" TextWrapping="NoWrap"
                                             AutomationProperties.Name="Caminho do gmad.exe"
                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource TextButton}" Content="Detectar"
                                            Click="Button_AutoDetectGmad_Click" />
                                    <Button Grid.Column="2" Margin="4,0,0,0" Style="{StaticResource OutlinedButton}" Content="Escolher…"
                                            Click="Button_BrowseGmad_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Passos, em ordem -->
                        <Border Style="{StaticResource M3Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Passos" />

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource SecondaryContainer}" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="1" FontWeight="SemiBold" Foreground="{DynamicResource OnSecondaryContainer}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Preparar" FontWeight="SemiBold" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                                   Text="Encontra os .bsp e separa o conteúdo que fica dentro deles." />
                                    </StackPanel>
                                    <Button x:Name="Button_MapScanRun" Grid.Column="2" Margin="12,0,0,0" MinWidth="190"
                                            Style="{StaticResource TonalButton}" Content="Preparar"
                                            Click="Button_MapScanRun_Click" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource Border}" Margin="42,12,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource SecondaryContainer}" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="2" FontWeight="SemiBold" Foreground="{DynamicResource OnSecondaryContainer}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Otimizar conteúdo" FontWeight="SemiBold" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                                   Text="Reduz as texturas e os sons separados, com as opções abaixo." />
                                    </StackPanel>
                                    <Button x:Name="Button_MapStageOptimize" Grid.Column="2" Margin="12,0,0,0" MinWidth="190"
                                            Style="{StaticResource TonalButton}" Content="Otimizar conteúdo"
                                            Click="Button_MapStageOptimize_Click" IsEnabled="False" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource Border}" Margin="42,12,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource SecondaryContainer}" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="3" FontWeight="SemiBold" Foreground="{DynamicResource OnSecondaryContainer}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Reconstruir mapa" FontWeight="SemiBold" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                                   Text="Coloca o conteúdo otimizado de volta no .bsp, numa pasta nova." />
                                    </StackPanel>
                                    <Button x:Name="Button_MapBuildRun" Grid.Column="2" Margin="12,0,0,0" MinWidth="190"
                                            Style="{StaticResource FilledButton}" Content="Reconstruir mapa"
                                            Click="Button_MapBuildRun_Click" IsEnabled="False" />
                                </Grid>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="2,14,0,0"
                                           Text="Só mexe no conteúdo embutido. Geometria, iluminação e visibilidade não mudam." />
                            </StackPanel>
                        </Border>

                        <!-- Opções de texturas e sons do mapa (as mesmas de Texturas e sons) -->
                        <Expander Style="{StaticResource M3Expander}" Header="Opções de texturas e sons do mapa">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="2,0,0,12"
                                           Text="São as mesmas opções de Avançado › Texturas e sons. Modelos dentro do mapa só são listados." />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Tipos de arquivo" />
                                <WrapPanel>
                                    <CheckBox Margin="0,0,16,8" IsChecked="{Binding CompressVTF}"><TextBlock Text="VTF" /></CheckBox>
                                    <CheckBox Margin="0,0,16,8" IsChecked="{Binding CompressWAV}"><TextBlock Text="WAV" /></CheckBox>
                                    <CheckBox Margin="0,0,16,8" IsChecked="{Binding CompressMP3}"><TextBlock Text="MP3" /></CheckBox>
                                    <CheckBox Margin="0,0,16,8" IsChecked="{Binding CompressOGG}"><TextBlock Text="OGG" /></CheckBox>
                                    <CheckBox Margin="0,0,16,8" IsChecked="{Binding CompressJPG}"><TextBlock Text="JPG" /></CheckBox>
                                    <CheckBox Margin="0,0,16,8" IsChecked="{Binding CompressPNG}"><TextBlock Text="PNG" /></CheckBox>
                                    <CheckBox Margin="0,0,0,8" IsChecked="{Binding CompressLUA}"><TextBlock Text="Lua" /></CheckBox>
                                </WrapPanel>

                                <TextBlock Style="{StaticResource FieldLabel}" Margin="2,14,0,6" Text="Imagens" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Reduzir" />
                                        <ComboBox ItemsSource="{Binding ImageReducingResolutionList}" SelectedIndex="{Binding ImageReducingResolutionListIndex, Mode=TwoWay}"
                                                  AutomationProperties.Name="Fator de redução" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Largura mínima" />
                                        <ComboBox ItemsSource="{Binding ImageSizeLimitList}" SelectedIndex="{Binding ImageWidthLimitIndex, Mode=TwoWay}"
                                                  AutomationProperties.Name="Largura mínima" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Altura mínima" />
                                        <ComboBox ItemsSource="{Binding ImageSizeLimitList}" SelectedIndex="{Binding ImageHeightLimitIndex, Mode=TwoWay}"
                                                  AutomationProperties.Name="Altura mínima" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Ignorar largura até" />
                                        <TextBox Text="{Binding ImageSkipWidth}" Height="40" Padding="12,0" VerticalContentAlignment="Center"
                                                 AutomationProperties.Name="Ignorar largura até" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Ignorar altura até" />
                                        <TextBox Text="{Binding ImageSkipHeight}" Height="40" Padding="12,0" VerticalContentAlignment="Center"
                                                 AutomationProperties.Name="Ignorar altura até" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox Margin="0,12,0,0" IsChecked="{Binding ReduceExactlyToLimits}"><TextBlock Text="Reduzir exatamente até os limites" TextWrapping="Wrap" /></CheckBox>
                                <CheckBox Margin="0,8,0,0" IsChecked="{Binding KeepImageAspectRatio}"><TextBlock Text="Manter a proporção" TextWrapping="Wrap" /></CheckBox>

                                <TextBlock Style="{StaticResource FieldLabel}" Margin="2,16,0,6" Text="Sons e scripts" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Taxa do WAV" />
                                        <ComboBox ItemsSource="{Binding WavRateList}" SelectedIndex="{Binding WavRateListIndex, Mode=TwoWay}"
                                                  AutomationProperties.Name="Taxa do WAV" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Perfil WAV" />
                                        <ComboBox ItemsSource="{Binding WavOptimizationList}" SelectedIndex="{Binding WavOptimizationIndex, Mode=TwoWay}"
                                                  AutomationProperties.Name="Perfil WAV" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Taxa do MP3 (kbps)" />
                                        <ComboBox ItemsSource="{Binding AudioBitrateList}" SelectedIndex="{Binding Mp3BitrateIndex, Mode=TwoWay}"
                                                  AutomationProperties.Name="Taxa do MP3" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Qualidade do OGG" />
                                        <ComboBox ItemsSource="{Binding OggQualityList}" SelectedIndex="{Binding OggQualityIndex, Mode=TwoWay}"
                                                  AutomationProperties.Name="Qualidade do OGG" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox Margin="0,12,0,0" IsChecked="{Binding AudioLoopSafe}"><TextBlock Text="Proteger os loops dos WAV" TextWrapping="Wrap" /></CheckBox>
                                <CheckBox Margin="0,8,0,0" IsChecked="{Binding ChangeOriginalCodeToMinimalistic}"><TextBlock Text="Minificar os scripts Lua do mapa" TextWrapping="Wrap" /></CheckBox>
                            </StackPanel>
                        </Expander>

                        <!-- Resumo -->
                        <Border Style="{StaticResource M3Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Resumo" />
                                <UniformGrid Columns="4">
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="Mapas (.bsp)" />
                                        <TextBlock x:Name="TextBlock_MapScanBspCount" Style="{StaticResource StatValue}" Text="0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="Com conteúdo válido" />
                                        <TextBlock x:Name="TextBlock_MapScanPakZipCount" Style="{StaticResource StatValue}" Text="0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="Mapas preparados" />
                                        <TextBlock x:Name="TextBlock_MapScanStagedBspCount" Style="{StaticResource StatValue}" Text="0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,12">
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="Arquivos separados" />
                                        <TextBlock x:Name="TextBlock_MapScanStagedFileCount" Style="{StaticResource StatValue}" Text="0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="Podem ser reconstruídos" />
                                        <TextBlock x:Name="TextBlock_MapScanCandidateCount" Style="{StaticResource StatValue}" Text="0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="Bloqueados" />
                                        <TextBlock x:Name="TextBlock_MapScanBlockedCount" Style="{StaticResource StatValue}" Text="0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="Tamanho do addon" />
                                        <TextBlock x:Name="TextBlock_MapScanAddonSize" Style="{StaticResource StatValue}" Text="0 B" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,2" Text="Conteúdo embutido" />
                                        <TextBlock x:Name="TextBlock_MapScanPakTotalSize" Style="{StaticResource StatValue}" Text="0 B" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Andamento -->
                        <Border Style="{StaticResource M3Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Andamento" />
                                <TextBlock x:Name="TextBlock_MapScanStatus" FontSize="16" FontWeight="SemiBold" Text="Aguardando" TextWrapping="Wrap" />
                                <ProgressBar x:Name="ProgressBar_MapScan" Height="6" Margin="0,12,0,12" Minimum="0" Maximum="100" Value="0" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0" Text="Etapa" />
                                    <TextBlock x:Name="TextBlock_MapScanPhase" Grid.Column="1" Foreground="{DynamicResource TextSecondary}" Text="—" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" Text="Agora" />
                                    <TextBlock x:Name="TextBlock_MapScanCurrent" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextSecondary}" Text="—" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                </Grid>
                                <Expander Style="{StaticResource M3Expander}" Header="Detalhes" Background="{DynamicResource Surface2}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Resumo do último passo" />
                                        <TextBox x:Name="TextBox_MapScanSummary" Style="{StaticResource ReportTextBox}" MinHeight="140"
                                                 VerticalContentAlignment="Top" AutomationProperties.Name="Resumo do último passo" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="2,14,0,6" Text="Log" />
                                        <TextBox x:Name="TextBox_MapScanLog" Style="{StaticResource LogTextBox}" Height="220"
                                                 VerticalContentAlignment="Top" AutomationProperties.Name="Log dos mapas" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- Limites e proteções -->
                        <Expander Style="{StaticResource M3Expander}" Header="Limites e proteções">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="2,0,0,8"
                                           Text="Só otimiza o conteúdo guardado dentro do .bsp (o pak), começando pelos VTF. Geometria, lightmaps, visibilidade e a estrutura do mapa não mudam." />
                                <TextBlock Style="{StaticResource FieldHint}" Margin="2,0,0,0"
                                           Text="O mapa só é reconstruído quando o .bsp continua válido, o conteúdo continua um ZIP válido e as posições internas cabem. Senão o mapa fica como está." />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="32,14">
                    <Grid MaxWidth="880">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="Button_MapScanOpenRoot" Style="{StaticResource TextButton}" Content="Abrir addon"
                                    Click="Button_MapScanOpenRoot_Click" IsEnabled="False" />
                            <Button x:Name="Button_MapScanOpenWork" Style="{StaticResource TextButton}" Content="Pasta de trabalho"
                                    Click="Button_MapScanOpenWork_Click" IsEnabled="False" />
                            <Button x:Name="Button_MapBuildOpenOutput" Style="{StaticResource TextButton}" Content="Abrir resultado"
                                    Click="Button_MapBuildOpenOutput_Click" IsEnabled="False" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="Button_MapScanCancel" Style="{StaticResource OutlinedButton}" Content="Cancelar"
                                    Click="Button_MapScanCancel_Click" IsEnabled="False" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
        <TabItem Header="Distribuição exata" x:Name="Tab_Exact">
            <Grid Background="{DynamicResource AppBackground}" TextElement.Foreground="{DynamicResource TextPrimary}">
                <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="880" Margin="32,22,32,24">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource PageTitle}" Text="Distribuição exata" />
                            <Border Style="{StaticResource M3Chip}" Margin="12,2,0,0">
                                <TextBlock Text="Experimental" FontSize="12" Foreground="{DynamicResource OnSecondaryContainer}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Compacta o addon sem nova perda de qualidade e gera uma pasta nova para testar no jogo." />

                        <!-- Pastas -->
                        <Border Style="{StaticResource M3Card}" Margin="0,20,0,0">
                            <StackPanel IsEnabled="{Binding UnlockedUI}">
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Pastas" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Addon de entrada" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="TextBox_ExactInput" Height="44" Padding="12,0" VerticalContentAlignment="Center"
                                             HorizontalScrollBarVisibility="Hidden"
                                             AutomationProperties.Name="Addon de entrada"
                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource TextButton}" Content="Usar o addon atual"
                                            Click="Button_ExactUseAddon_Click" />
                                    <Button Grid.Column="2" Margin="4,0,0,0" Style="{StaticResource OutlinedButton}" Content="Escolher…"
                                            Tag="input" Click="Button_ExactBrowse_Click" />
                                </Grid>
                                <TextBlock Style="{StaticResource FieldHint}" Text="Pode ser o addon original ou um resultado do Otimizar." />

                                <TextBlock Style="{StaticResource FieldLabel}" Margin="2,16,0,6" Text="Salvar em (pasta nova)" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="TextBox_ExactOutput" Height="44" Padding="12,0" VerticalContentAlignment="Center"
                                             HorizontalScrollBarVisibility="Hidden"
                                             AutomationProperties.Name="Salvar em"
                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource OutlinedButton}" Content="Escolher local…"
                                            Tag="output" Click="Button_ExactBrowse_Click" />
                                </Grid>
                                <TextBlock Style="{StaticResource FieldHint}" Text="A pasta não pode existir: ela é criada ao exportar." />

                                <TextBlock Style="{StaticResource FieldLabel}" Margin="2,16,0,6" Text="Garry's Mod (pasta de instalação)" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="TextBox_ExactEngine" Height="44" Padding="12,0" VerticalContentAlignment="Center"
                                             HorizontalScrollBarVisibility="Hidden"
                                             AutomationProperties.Name="Pasta de instalação do Garry's Mod"
                                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource OutlinedButton}" Content="Escolher…"
                                            Tag="engine" Click="Button_ExactBrowse_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Expander Style="{StaticResource M3Expander}" Header="Como funciona">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="2,0,0,8"
                                           Text="Os arquivos são compactados e reconstruídos byte a byte no jogo. Se um arquivo não fica menor, ele vai como está. A exportação só cria a pasta: não instala nada nem abre o jogo." />
                                <TextBlock Style="{StaticResource FieldHint}" Margin="2,0,0,8"
                                           Text="Os .dx80.vtx e .sw.vtx ficam de fora só da distribuição; o .dx90.vtx é mantido. O relatório separa essa economia da compactação." />
                                <TextBlock Style="{StaticResource FieldHint}" Margin="2,0,0,0"
                                           Text="No GMod, um script Lua reconstrói os arquivos e guarda um cache: a primeira carga pode demorar e o cache ocupa disco. Teste com o cache vazio e cheio antes de publicar." />
                            </StackPanel>
                        </Expander>

                        <!-- Andamento -->
                        <Border Style="{StaticResource M3Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Andamento" />
                                <TextBlock x:Name="TextBlock_ExactStatus" FontSize="16" FontWeight="SemiBold" Text="Pronto para exportar." TextWrapping="Wrap" />
                                <ProgressBar x:Name="ProgressBar_Exact" Height="6" Margin="0,12,0,0" Minimum="0" Maximum="100" />
                                <Expander Style="{StaticResource M3Expander}" Header="Detalhes" Background="{DynamicResource Surface2}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Resumo" />
                                        <TextBox x:Name="TextBox_ExactSummary" IsReadOnly="True" TextWrapping="Wrap" MinHeight="90"
                                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                                 AutomationProperties.Name="Resumo da exportação" />
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="2,14,0,6" Text="Log" />
                                        <TextBox x:Name="TextBox_ExactLog" Style="{StaticResource LogTextBox}" IsReadOnly="True" TextWrapping="NoWrap" Height="220"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                                 AutomationProperties.Name="Log da exportação" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="32,14">
                    <Grid MaxWidth="880">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="Button_ExactOpenOutput" Style="{StaticResource TextButton}" Content="Abrir resultado"
                                    Click="Button_ExactOpenOutput_Click" IsEnabled="False" />
                            <Button x:Name="Button_ExactOpenReport" Style="{StaticResource TextButton}" Content="Ver relatório"
                                    Click="Button_ExactOpenReport_Click" IsEnabled="False" />
                            <Button Style="{StaticResource TextButton}" Content="Pasta de trabalho" Click="Button_ExactOpenWork_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="Button_ExactCancel" Style="{StaticResource OutlinedButton}" Content="Cancelar" Margin="0,0,8,0"
                                    Click="Button_ExactCancel_Click" IsEnabled="False" />
                            <Button Style="{StaticResource FilledButton}" Content="Exportar" Click="Button_ExactExport_Click"
                                    IsEnabled="{Binding UnlockedUI}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
        <TabItem Header="Pipeline" x:Name="Tab_Pipeline"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <Grid Background="{DynamicResource AppBackground}" Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardEyebrowText}" Text="PIPELINE INPUT" />
                        <TextBlock Style="{StaticResource CardHeaderTitle}" Text="Addon" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Margin="0,0,0,12"
                                   Text="Pick the addon root used for the chained Models then Compress workflow." />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource LabelText}" Text="Source addon" />
                            <Button Style="{StaticResource HelpIconButton}"
                                    Content="?"
                                    Margin="8,0,0,0"
                                    ToolTipService.Placement="Mouse"
                                    ToolTipService.InitialShowDelay="250"
                                    ToolTipService.ShowDuration="35000">
                                <Button.ToolTip>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="Addon usado no Pipeline (Models → Compress)." />
                                        <LineBreak />
                                        <Run Text="Efeito: a compressão roda no output otimizado (quando Models termina com sucesso)." />
                                    </TextBlock>
                                </Button.ToolTip>
                            </Button>
                        </StackPanel>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="Button_SelectDirectoryPipeline"
                                    Style="{StaticResource ButtonAccent}"
                                    Content="Select Addon"
                                    Width="118"
                                    IsEnabled="{Binding UnlockedUI}" />
                            <TextBox Grid.Column="1"
                                     Margin="12,0,0,0"
                                     IsReadOnly="True"
                                     Text="{Binding AddonDirectoryPath}"
                                     TextWrapping="NoWrap"
                                     HorizontalScrollBarVisibility="Hidden"  Height="40" VerticalContentAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Grid>

                        <Border Style="{StaticResource CardInnerPanel}"
                                Margin="0,12,0,0"
                                Visibility="{Binding AddonWorkshopWarningVisibility}"
                                BorderBrush="{DynamicResource Danger}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}"
                                           Foreground="{DynamicResource Danger}"
                                           Text="Workshop warning" />
                                <TextBox Margin="0,10,0,0"
                                         Text="{Binding AddonWorkshopWarningText}"
                                         Style="{StaticResource ReportTextBox}"
                                         Foreground="{DynamicResource Danger}"
                                         BorderBrush="{DynamicResource Danger}"
                                         MinHeight="96"  VerticalContentAlignment="Top"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardEyebrowText}" Text="PIPELINE FLOW" />
                        <TextBlock Style="{StaticResource CardHeaderTitle}" Text="Pipeline Steps" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Margin="0,0,0,12"
                                   Text="Run the fixed Models then Compress sequence. This tab orchestrates the flow without changing either step's logic." />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource LabelText}" Text="Execution order" />
                            <Button Style="{StaticResource HelpIconButton}"
                                    Content="?"
                                    Margin="8,0,0,0"
                                    ToolTipService.Placement="Mouse"
                                    ToolTipService.InitialShowDelay="250"
                                    ToolTipService.ShowDuration="45000">
                                <Button.ToolTip>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="Executa as etapas em sequência (uma de cada vez):" />
                                        <LineBreak />
                                        <Run Text="1) Models: otimiza/recompila modelos e gera output." />
                                        <LineBreak />
                                        <Run Text="2) Compress: comprime recursos no output gerado." />
                                        <LineBreak />
                                        <Run Text="Cancel: interrompe a etapa atual com segurança (sem travar a UI)." />
                                    </TextBlock>
                                </Button.ToolTip>
                            </Button>
                        </StackPanel>
                        <Border Style="{StaticResource CardInnerPanel}" Margin="0,16,0,0">
                            <StackPanel>
                                <CheckBox IsChecked="True" IsEnabled="False" ><TextBlock Text="Run Models" TextWrapping="Wrap" /></CheckBox>
                                <CheckBox Margin="0,8,0,0" IsChecked="True" IsEnabled="False" ><TextBlock Text="Run Compress" TextWrapping="Wrap" /></CheckBox>
                                <CheckBox x:Name="CheckBox_PipelineExact" Margin="0,12,0,0" IsChecked="False"
                                          IsEnabled="{Binding UnlockedUI}" ><TextBlock Text="Distribuição exata no final (experimental)" TextWrapping="Wrap" /></CheckBox>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="Opcional: após sucesso das duas etapas, exporta para uma nova pasta ao lado e mantém o intermediário nativo. Configure a engine na aba Distribuição exata. O candidato ainda exige validação no GMod." />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0" Text="Compress runs on the optimized output from the Models step." />
                            </StackPanel>
                        </Border>

                        <Border x:Name="PipelineCompanionProfileCard"
                                Style="{StaticResource CardInnerPanel}"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="Maximum v2 runtime evidence (optional)" />
                                <CheckBox Margin="0,8,0,0"
                                          IsChecked="{Binding UseWithMaximumV2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Content="Use with Models Maximum v2" IsEnabled="{Binding CanUseWithMaximumV2}" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="0,6,0,0"
                                           Text="{Binding ProfileCompatibilityText}"
                                           TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="0,3,0,0"
                                           Text="{Binding ProfileMatchText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardEyebrowText}" Text="EXECUTION" />
                        <TextBlock Style="{StaticResource CardHeaderTitle}" Text="Progress and Report" />
                        <TextBlock Style="{StaticResource HintText}"
                                   Margin="0,0,0,12"
                                   Text="Track the current phase, inspect the final summary, and open the generated folders from one consistent execution panel." />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource LabelText}" Text="Session status" />
                            <Button Style="{StaticResource HelpIconButton}"
                                    Content="?"
                                    Margin="8,0,0,0"
                                    ToolTipService.Placement="Mouse"
                                    ToolTipService.InitialShowDelay="250"
                                    ToolTipService.ShowDuration="45000">
                                <Button.ToolTip>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="Mostra o progresso da etapa atual (Phase + Current item) e um resumo final." />
                                        <LineBreak />
                                        <Run Text="Open Output/Work/Logs ficam disponíveis quando houver caminhos detectados." />
                                        <LineBreak />
                                        <Run Text="Copy Summary copia um resumo (paths + exit codes + última linha de erro) para facilitar report de bugs." />
                                    </TextBlock>
                                </Button.ToolTip>
                            </Button>
                        </StackPanel>

                        <Border Style="{StaticResource CardInnerPanel}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="Progress" />
                                <ProgressBar x:Name="ProgressBar_Pipeline"
                                             Margin="0,10,0,0"
                                             Minimum="{Binding PipelineProgressMinValue}"
                                             Maximum="{Binding PipelineProgressMaxValue}"
                                             Value="{Binding PipelineProgressValue}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardInnerPanel}" Margin="0,12,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelText}" Text="Phase" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Margin="16,0,0,0"
                                           Style="{StaticResource StatusTextBlockStyle}"
                                           Text="{Binding PipelineStatusText}" />

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Margin="0,10,0,0"
                                           Style="{StaticResource LabelText}"
                                           Text="Current item" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Margin="16,10,0,0"
                                           Style="{StaticResource ValueText}"
                                           Text="{Binding PipelineProgressText}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardInnerPanel}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="Summary" />
                                <TextBox Text="{Binding PipelineSummaryText}"
                                         Style="{StaticResource ReportTextBox}"
                                         Margin="0,10,0,0"
                                         MinHeight="92"  VerticalContentAlignment="Top"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardInnerPanel}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelText}" Text="Size report" />
                                <TextBox Text="{Binding PipelineSizeReportText}"
                                         Style="{StaticResource ReportTextBox}"
                                         Margin="0,10,0,0"  VerticalContentAlignment="Top"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ActionBarCard}" Margin="0,12,0,0">
                            <UniformGrid Columns="2">
                                <Button x:Name="Button_OpenPipelineOutput"
                                        Content="Open Output"
                                        IsEnabled="False"
                                        Margin="0,0,8,8" />
                                <Button x:Name="Button_OpenPipelineWork"
                                        Content="Open Work"
                                        IsEnabled="False"
                                        Margin="0,0,0,8" />
                                <Button x:Name="Button_OpenPipelineLogs"
                                        Content="Open Logs"
                                        IsEnabled="False"
                                        Margin="0,0,8,0" />
                                <Button x:Name="Button_CopyPipelineSummary"
                                        Content="Copy Summary"
                                        IsEnabled="False" />
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>
                </Grid>
            </ScrollViewer><Border Grid.Row="1" Margin="12,0,12,12"><Border Style="{StaticResource ActionBarCard}" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="Button_StartPipeline"
                                        Style="{StaticResource ButtonAccent}"
                                        Content="Run Pipeline"
                                        Width="140"
                                        IsEnabled="{Binding PipelineCanStart}" />
                                <Button x:Name="Button_CancelPipeline"
                                        Style="{StaticResource ButtonDanger}"
                                        Margin="8,0,0,0"
                                        Content="Cancel"
                                        Width="90"
                                        IsEnabled="False" />
                            </StackPanel>
                        </Border></Border></Grid></TabItem>
        <TabItem Header="Testar no jogo" x:Name="Tab_Companion">
            <Grid x:Name="CompanionTabRoot" Background="{DynamicResource AppBackground}" TextElement.Foreground="{DynamicResource TextPrimary}">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <StackPanel MaxWidth="880" Margin="32,22,32,24">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Testar no jogo" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Instala um addon de teste no Garry's Mod para conferir o resultado no jogo." />

                        <!-- Addon de teste -->
                        <Border Style="{StaticResource M3Card}" Margin="0,20,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource M3Chip}">
                                        <TextBlock Text="{Binding InstallationStatusLabel}" FontSize="12" Foreground="{DynamicResource OnSecondaryContainer}" />
                                    </Border>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Addon de teste" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource FieldHint}" Text="{Binding InstallationDetailText}" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Pasta do Garry's Mod" Margin="2,16,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding GarrysModRoot}" IsReadOnly="True" Height="44" Padding="12,0"
                                             VerticalContentAlignment="Center" TextWrapping="NoWrap"
                                             AutomationProperties.Name="Pasta do Garry's Mod" />
                                    <Button x:Name="Button_CompanionBrowseGame" Grid.Column="1" Style="{StaticResource OutlinedButton}"
                                            Content="Escolher…" Margin="8,0,0,0" IsEnabled="{Binding CanImportProfile}" />
                                    <Button x:Name="Button_CompanionDetectGame" Grid.Column="2" Style="{StaticResource TextButton}"
                                            Content="Detectar" Margin="4,0,0,0" IsEnabled="{Binding CanImportProfile}" />
                                </Grid>
                                <TextBlock Style="{StaticResource FieldHint}" TextTrimming="CharacterEllipsis">
                                    <Run Text="Versão instalada:" />
                                    <Run Text="{Binding InstalledVersionText, Mode=OneWay}" />
                                    <Run Text="  ·  " />
                                    <Run Text="{Binding InstallDestinationText, Mode=OneWay}" />
                                </TextBlock>

                                <WrapPanel Margin="0,16,0,0">
                                    <Button x:Name="Button_CompanionInstall" Style="{StaticResource FilledButton}" Content="Instalar"
                                            Margin="0,0,8,0" IsEnabled="{Binding CanInstall}" />
                                    <Button x:Name="Button_CompanionUpdate" Style="{StaticResource TonalButton}" Content="Atualizar"
                                            Margin="0,0,8,0" IsEnabled="{Binding CanUpdate}" />
                                    <Button x:Name="Button_CompanionRemove" Style="{StaticResource OutlinedButton}" Content="Remover"
                                            Margin="0,0,8,0" IsEnabled="{Binding CanRemove}" />
                                    <Button x:Name="Button_CompanionOpenData" Style="{StaticResource TextButton}" Content="Abrir pasta de dados"
                                            IsEnabled="{Binding CanOpenDataFolder}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Como testar -->
                        <Border Style="{StaticResource M3Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Como testar" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Width="24" Height="24" VerticalAlignment="Top" Margin="0,0,12,10">
                                        <Ellipse Fill="{DynamicResource SecondaryContainer}" />
                                        <TextBlock Text="1" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnSecondaryContainer}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="Instale o addon de teste e reinicie o Garry's Mod." TextWrapping="Wrap" Margin="0,2,0,10" />
                                    <Grid Grid.Row="1" Width="24" Height="24" VerticalAlignment="Top" Margin="0,0,12,10">
                                        <Ellipse Fill="{DynamicResource SecondaryContainer}" />
                                        <TextBlock Text="2" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnSecondaryContainer}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Otimize o addon e gere o plano de teste aqui embaixo." TextWrapping="Wrap" Margin="0,2,0,10" />
                                    <Grid Grid.Row="2" Width="24" Height="24" VerticalAlignment="Top" Margin="0,0,12,10">
                                        <Ellipse Fill="{DynamicResource SecondaryContainer}" />
                                        <TextBlock Text="3" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnSecondaryContainer}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="No jogo, abra Utilities › Source Addon Optimizer e rode o plano." TextWrapping="Wrap" Margin="0,2,0,10" />
                                    <Grid Grid.Row="3" Width="24" Height="24" VerticalAlignment="Top" Margin="0,0,12,0">
                                        <Ellipse Fill="{DynamicResource SecondaryContainer}" />
                                        <TextBlock Text="4" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnSecondaryContainer}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Importe os resultados e confira a lista." TextWrapping="Wrap" Margin="0,2,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Plano de teste -->
                        <Border Style="{StaticResource M3Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Plano de teste" Margin="0" />
                                <TextBlock Style="{StaticResource FieldHint}"
                                           Text="Lista o que mudou no addon otimizado para conferir no jogo. Por enquanto precisa de um resultado do modo Maximum (Avançado › Modelos)." />
                                <WrapPanel Margin="0,16,0,0">
                                    <Button x:Name="Button_CompanionGeneratePlan" Style="{StaticResource FilledButton}" Content="Gerar plano"
                                            Margin="0,0,8,0" IsEnabled="{Binding CanGeneratePlan}" />
                                    <Button x:Name="Button_CompanionCopyPlan" Style="{StaticResource OutlinedButton}" Content="Copiar plano"
                                            Margin="0,0,8,0" />
                                    <Button x:Name="Button_CompanionOpenPlan" Style="{StaticResource TextButton}" Content="Abrir pasta do plano"
                                            Margin="0,0,8,0" />
                                    <Button x:Name="Button_CompanionImportResults" Style="{StaticResource TonalButton}" Content="Importar resultados"
                                            IsEnabled="{Binding CanImportResults}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Resultados -->
                        <Border Style="{StaticResource M3Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="Button_CompanionCopyResults" Style="{StaticResource TextButton}" Content="Copiar resumo"
                                                IsEnabled="{Binding CanCopyValidationSummary}" />
                                        <Button x:Name="Button_CompanionExportResults" Style="{StaticResource TextButton}" Content="Exportar"
                                                Margin="4,0,0,0" IsEnabled="{Binding CanExportValidationSummary}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="Resultados" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>
                                <WrapPanel Margin="0,12,0,0">
                                    <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CompanionResultFilter" Content="Todos"
                                                 IsChecked="{Binding ValidationStatusFilter, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=ALL, Mode=TwoWay}" />
                                    <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CompanionResultFilter" Content="Falhou"
                                                 IsChecked="{Binding ValidationStatusFilter, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=FAILED, Mode=TwoWay}" />
                                    <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CompanionResultFilter" Content="Atenção"
                                                 IsChecked="{Binding ValidationStatusFilter, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=WARNING, Mode=TwoWay}" />
                                    <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CompanionResultFilter" Content="Incompleto"
                                                 IsChecked="{Binding ValidationStatusFilter, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=INCOMPLETE, Mode=TwoWay}" />
                                    <RadioButton Style="{StaticResource ChoiceChip}" GroupName="CompanionResultFilter" Content="Passou"
                                                 IsChecked="{Binding ValidationStatusFilter, Converter={StaticResource ValueEqualsConverter}, ConverterParameter=PASS, Mode=TwoWay}" />
                                </WrapPanel>

                                <TextBlock Style="{StaticResource FieldHint}" Text="Nenhum resultado importado ainda." Margin="2,4,0,0"
                                           Visibility="{Binding HasNoValidationResults, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <Grid Margin="0,8,0,0" Visibility="{Binding HasValidationResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ListBox MinHeight="200" MaxHeight="420" Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemsSource="{Binding ValidationResources}"
                                             SelectedItem="{Binding SelectedValidationResource, Mode=TwoWay}"
                                             AutomationProperties.Name="Resultados do teste">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="0,0,0,4">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2}" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SecondaryContainer}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock x:Name="StatusText" Text="{Binding StatusLabel}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                                                    <TextBlock Text="{Binding Path}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding Reason}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding WarningText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="FAILED">
                                                        <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource Danger}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="WARNING">
                                                        <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource Warning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="PASS">
                                                        <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource Success}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Border Grid.Column="1" Background="{DynamicResource Surface2}" CornerRadius="12" Padding="12" Margin="12,0,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Captura do jogo" />
                                            <Image MaxHeight="300" Stretch="Uniform" Source="{Binding SelectedValidationResource.PrimaryScreenshotPath}" />
                                            <TextBlock Style="{StaticResource FieldHint}" Text="{Binding SelectedValidationResource.PrimaryScreenshotPath}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <Button x:Name="Button_CompanionOpenScreenshot" Style="{StaticResource OutlinedButton}" Content="Abrir captura"
                                                    HorizontalAlignment="Left" Margin="0,10,0,0" IsEnabled="{Binding CanOpenValidationScreenshot}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Expander Style="{StaticResource M3Expander}" Header="Detalhes da validação">
                            <TextBlock Text="{Binding ValidationSummaryText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                        </Expander>

                        <Expander Style="{StaticResource M3Expander}" Header="Perfil de uso para o modo Maximum (antigo)">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldHint}" Margin="2,0,0,0"
                                           Text="Perfil gravado enquanto você usa o addon no jogo. Ajuda o modo Maximum (Avançado › Modelos) a decidir o que importa; só é usado se você marcar a opção lá." />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Último perfil" Margin="2,14,0,6" />
                                <TextBox Text="{Binding LastProfilePath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="44" Padding="12,10"
                                         AutomationProperties.Name="Último perfil importado" />
                                <TextBlock Style="{StaticResource FieldHint}" Text="{Binding ProfileSummaryText}" />
                                <TextBlock Style="{StaticResource FieldHint}" Text="{Binding ProfileOriginText}" Margin="2,4,0,0" />
                                <TextBlock Style="{StaticResource FieldHint}" Text="{Binding ProfileAgeText}" Margin="2,2,0,0" />
                                <TextBlock Style="{StaticResource FieldHint}" Text="{Binding ProfileMatchText}" Margin="2,2,0,0" />
                                <TextBlock Style="{StaticResource FieldHint}" Text="{Binding ProfileTruncationText}" Margin="2,2,0,0" />
                                <TextBlock Style="{StaticResource FieldHint}" Text="{Binding ProfileCompatibilityText}" Margin="2,2,0,0" />
                                <Button x:Name="Button_CompanionImportProfile" Style="{StaticResource OutlinedButton}" Content="Importar perfil"
                                        HorizontalAlignment="Left" Margin="0,14,0,0" IsEnabled="{Binding CanImportProfile}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- Status and cancel -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="32,14">
                    <Grid MaxWidth="880">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{Binding OperationStatusText}" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding OperationStatusText}" />
                            <ProgressBar Height="4" MaxWidth="320" HorizontalAlignment="Left" Margin="0,8,0,0" Minimum="0" Maximum="100"
                                         Value="{Binding ProgressValue}"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <Button x:Name="Button_CompanionCancel" Grid.Column="1" Style="{StaticResource OutlinedButton}" Content="Cancelar"
                                IsEnabled="{Binding CanCancel}" />
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
        </TabControl>
    </Grid>
</Window>
