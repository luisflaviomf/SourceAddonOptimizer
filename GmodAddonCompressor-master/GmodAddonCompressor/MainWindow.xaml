                            </Border>
                            <Border Style="{StaticResource ActionBarCard}" Margin="0,12,0,0">
                                <StackPanel>
                                    <Button x:Name="Button_CompanionImportProfile"
                                            Style="{StaticResource ButtonAccent}"
                                            Content="Import Runtime Profile"
                                            HorizontalAlignment="Left"
                                            MinWidth="172"
                                            IsEnabled="{Binding CanImportProfile}" />
                                    <TextBlock Style="{StaticResource MutedText}"
                                               Margin="0,8,0,0"
                                               Text="Profile use is Maximum v2-only and remains off until you explicitly opt in."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardEyebrowText}" Text="VALIDATION LOOP" />
                            <TextBlock Style="{StaticResource CardHeaderTitle}" Text="Transfer &amp; results" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Generate a declarative test plan for changed assets, run it in-game, then import structural and visual results. Remote servers use manual file transfer—no credentials are stored." />
                            <Border Style="{StaticResource CardInnerPanel}" Margin="0,16,0,0">
                                <TextBlock Text="{Binding ValidationSummaryText}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </Border>
                            <Border Style="{StaticResource ActionBarCard}" Margin="0,12,0,0">
                                <WrapPanel>
                                    <Button x:Name="Button_CompanionGeneratePlan"
                                            Style="{StaticResource ButtonAccent}"
                                            Content="Generate Plan"
                                            MinWidth="126"
                                            IsEnabled="{Binding CanGeneratePlan}" />
                                    <Button x:Name="Button_CompanionImportResults"
                                            Margin="8,0,0,0"
                                            Content="Import Results"
                                            MinWidth="126"
                                            IsEnabled="{Binding CanImportResults}" />
                                    <Button x:Name="Button_CompanionCopyPlan"
                                            Margin="8,0,0,0"
                                            Content="Copy Plan"
                                            MinWidth="104" />
                                    <Button x:Name="Button_CompanionOpenPlan"
                                            Margin="8,0,0,0"
                                            Content="Open Plan"
                                            MinWidth="104" />
                                </WrapPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardEyebrowText}" Text="QUICK START" />
                            <TextBlock Style="{StaticResource CardHeaderTitle}" Text="A closed, optional loop" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Foreground="{DynamicResource Accent}" FontWeight="Bold" Text="01" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Install the Companion and restart Garry's Mod." TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Margin="0,12,0,0" Foreground="{DynamicResource Accent}" FontWeight="Bold" Text="02" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Text="Open Utilities → Source Addon Optimizer and record a representative session." TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Margin="0,12,0,0" Foreground="{DynamicResource Accent}" FontWeight="Bold" Text="03" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" Text="Import the profile; enable it only if you want Maximum v2 to use positive importance evidence." TextWrapping="Wrap" />
                                <TextBlock Grid.Row="3" Margin="0,12,0,0" Foreground="{DynamicResource Accent}" FontWeight="Bold" Text="04" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,12,0,0" Text="Optimize, validate in-game, and import the result bundle." TextWrapping="Wrap" />
                            </Grid>

                            <Border Style="{StaticResource ActionBarCard}" Margin="0,18,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource StatusTextBlockStyle}"
                                                   Text="{Binding OperationStatusText}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                        <Button x:Name="Button_CompanionCancel"
                                                Grid.Column="1"
                                                Style="{StaticResource ButtonDanger}"
                                                Margin="12,0,0,0"
