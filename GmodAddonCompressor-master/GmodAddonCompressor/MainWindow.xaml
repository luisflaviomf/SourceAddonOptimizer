                                                 TextWrapping="NoWrap"
                                                 HorizontalScrollBarVisibility="Auto" />
                                        <Button x:Name="Button_CompanionBrowseGame"
                                                Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Content="Select"
                                                MinWidth="82"
                                                IsEnabled="{Binding CanImportProfile}" />
                                        <Button x:Name="Button_CompanionDetectGame"
                                                Grid.Column="2"
                                                Margin="8,0,0,0"
                                                Content="Detect"
                                                MinWidth="82"
                                                IsEnabled="{Binding CanImportProfile}" />
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource LabelText}" Text="State" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="14,0,0,0"
                                                   Style="{StaticResource ValueText}"
