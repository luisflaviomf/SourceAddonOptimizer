                                    <Button DockPanel.Dock="Right" Content="Sugerir ao lado de..." Tag="output" Click="Button_ExactBrowse_Click" Margin="8,0,0,0" />
                                    <TextBox x:Name="TextBox_ExactOutput"  Height="40" HorizontalScrollBarVisibility="Hidden" VerticalContentAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
