<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VtfMaximumLab</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="AssemblyInfo.cs" />
    <!-- Codec pieces (Candidates, Encoding, Inventory, Validation) are compiled into the WPF product for Magick+. -->
    <Compile Include="Baseline/*.cs" />
    <Compile Include="Experiment/*.cs" />
    <Compile Include="Images/*.cs" />
    <Compile Include="Metrics/*.cs" />
    <Compile Include="Reporting/*.cs" />
    <Compile Include="Sampling/*.cs" />
    <Compile Include="Selection/*.cs" />
    <Compile Include="Tools/*.cs" />
    <ProjectReference Include="..\..\GmodAddonCompressor-master\GmodAddonCompressor\GmodAddonCompressor.csproj" />
  </ItemGroup>
</Project>
