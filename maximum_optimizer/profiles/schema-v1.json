{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gmod-addon-optimizer.local/schemas/maximum-fidelity-profile-v1.json",
  "title": "Maximum fidelity profile v1",
  "type": "object",
  "required": ["schema", "version", "calibrated", "limits"],
  "properties": {
    "schema": {"const": 1},
    "version": {"type": "string", "minLength": 1},
    "calibrated": {"type": "boolean"},
    "corpus_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "limits": {
      "type": "object",
      "properties": {
        "silhouette_iou": {"type": "number", "minimum": 0},
        "rgb_mae": {"type": "number", "minimum": 0},
        "edge_error": {"type": "number", "minimum": 0},
        "surface_bidirectional_p95": {"type": "number", "minimum": 0},
        "surface_max": {"type": "number", "minimum": 0},
        "normal_angle_p95": {"type": "number", "minimum": 0},
        "uv_error_p95": {"type": "number", "minimum": 0},
        "skinning_error_p95": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"calibrated": {"const": true}}},
      "then": {
        "required": ["corpus_hash"],
        "properties": {
          "limits": {
            "required": [
              "silhouette_iou",
              "rgb_mae",
              "edge_error",
              "surface_bidirectional_p95",
              "surface_max",
              "normal_angle_p95",
              "uv_error_p95",
              "skinning_error_p95"
            ]
          }
        }
      },
      "else": {
        "properties": {"limits": {"maxProperties": 0}}
      }
    }
  ],
  "additionalProperties": true
}
