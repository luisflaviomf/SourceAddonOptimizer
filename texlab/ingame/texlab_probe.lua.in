-- texlab in-game probe (client only). Renders each model with fixed studio lighting,
-- checks every material/texture the engine loaded, captures PNGs and quits.
if SERVER then return end

local MODELS = __MODELS__          -- { {mdl = "models/...mdl", skin = 0, color = {r,g,b} or nil, tag = "..."} }
local RUN = "__RUN__"
local OUT = "texlab/" .. RUN

local results = { run = RUN, models = {} }
local cam_state = nil
local pending_capture = nil
local co = nil

local function wait_frames(n)
    for _ = 1, n do coroutine.yield() end
end

local function tex_info(mat, key)
    local t = mat:GetTexture(key)
    if not t then return nil end
    return { name = t:GetName(), error = t:IsError(), w = t:Width(), h = t:Height() }
end

hook.Add("RenderScene", "texlab_probe", function()
    if not cam_state then return end
    local s = cam_state
    render.Clear(46, 51, 56, 255, true, true)
    cam.Start3D(s.origin, s.angles, 75, 0, 0, ScrW(), ScrH(), 1, 20000)
        render.SuppressEngineLighting(true)
        render.SetLightingOrigin(s.target)
        render.ResetModelLighting(0.35, 0.35, 0.37)
        render.SetModelLighting(0, 0.9, 0.88, 0.85)   -- +x
        render.SetModelLighting(2, 0.55, 0.55, 0.6)   -- +y
        render.SetModelLighting(4, 1.0, 1.0, 1.0)     -- +z (sky)
        render.SetModelLighting(5, 0.15, 0.15, 0.15)  -- -z (ground)
        if IsValid(s.ent) then s.ent:DrawModel() end
        render.SuppressEngineLighting(false)
    cam.End3D()
    return true
end)

hook.Add("PostRender", "texlab_probe_capture", function()
    if not pending_capture then return end
    local data = render.Capture({ format = "png", x = 0, y = 0, w = ScrW(), h = ScrH(), alpha = false })
    if data then file.Write(pending_capture, data) end
    pending_capture = nil
end)

local function run()
    file.CreateDir(OUT)
    for idx, item in ipairs(MODELS) do
        util.PrecacheModel(item.mdl)
        local ent = ClientsideModel(item.mdl, RENDERGROUP_OPAQUE)
        local rec = { mdl = item.mdl, tag = item.tag, valid = IsValid(ent), materials = {} }
        results.models[#results.models + 1] = rec
        if IsValid(ent) then
            ent:SetNoDraw(true)
            ent:SetPos(Vector(0, 0, 0))
            ent:SetAngles(Angle(0, 0, 0))
            ent:SetSkin(item.skin or 0)
            if item.color then ent:SetColor(Color(item.color[1], item.color[2], item.color[3])) end
            local mins, maxs = ent:GetRenderBounds()
            local center = (mins + maxs) * 0.5
            local radius = (maxs - mins):Length() * 0.5
            rec.radius = radius
            for _, name in ipairs(ent:GetMaterials()) do
                local m = Material(name)
                rec.materials[#rec.materials + 1] = {
                    name = name, error = m:IsError(), shader = m:GetShader(),
                    base = tex_info(m, "$basetexture"), bump = tex_info(m, "$bumpmap"),
                }
            end
            local views = __VIEWS__
            for vi, v in ipairs(views) do
                local dir = Angle(v.pitch, v.yaw, 0):Forward()
                local origin = center - dir * radius * v.dist
                cam_state = { ent = ent, origin = origin, angles = dir:Angle(), target = center }
                wait_frames(idx == 1 and vi == 1 and 120 or 25)   -- let textures stream in
                pending_capture = string.format("%s/%02d_%s_v%d.png", OUT, idx, item.tag, vi)
                wait_frames(3)
            end
            ent:Remove()
        end
    end
    cam_state = nil
    file.Write(OUT .. "/report.json", util.TableToJSON(results, true))
    print("texlab_probe_done " .. RUN)
    -- "quit" is blocked for Lua; the runner closes the client once report.json exists
end

hook.Add("InitPostEntity", "texlab_probe_start", function()
    timer.Simple(3, function()
        co = coroutine.create(run)
        hook.Add("Think", "texlab_probe_step", function()
            if co and coroutine.status(co) ~= "dead" then
                local ok, err = coroutine.resume(co)
                if not ok then
                    print("texlab_probe_error " .. tostring(err))
                    file.Write(OUT .. "/error.txt", tostring(err))
                    file.Write(OUT .. "/report.json", util.TableToJSON(results, true))
                end
            end
        end)
    end)
end)
